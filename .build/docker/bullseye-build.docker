FROM debian:bullseye
LABEL org.opencontainers.image.authors="Apache Cassandra <dev@cassandra.apache.org>"

# CONTEXT is expected to be cassandra/.build

ENV DIST_DIR=/dist
ENV BUILD_HOME=/home/build
ENV CASSANDRA_DIR=$BUILD_HOME/cassandra

LABEL org.cassandra.buildenv=debian_build

RUN echo "Building with arguments:" \
    && echo " - DIST_DIR=${DIST_DIR}" \
    && echo " - BUILD_HOME=${BUILD_HOME}" \
    && echo " - CASSANDRA_DIR=${CASSANDRA_DIR}"

# configure apt to retry downloads
RUN echo 'APT::Acquire::Retries "99";' > /etc/apt/apt.conf.d/80-retries
RUN echo 'Acquire::http::Timeout "60";' > /etc/apt/apt.conf.d/80proxy.conf
RUN echo 'Acquire::ftp::Timeout "60";' >> /etc/apt/apt.conf.d/80proxy.conf

# Debian 11 (bullseye) is EOL; its packages now live on archive.debian.org
RUN sed -i -e 's|http://deb.debian.org/debian-security|http://archive.debian.org/debian-security|' \
           -e 's|http://deb.debian.org/debian|http://archive.debian.org/debian|' \
           -e '/bullseye-updates/d' /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99archive-valid-until

# install deps
RUN for i in 1 2 3 4 5; do \
        apt-get update \
        && apt-get -y install ant build-essential curl devscripts ed git sudo \
                python3-pip rsync procps dh-python quilt bash-completion \
        && apt-get clean && rm -rf /var/lib/apt/lists/* \
        && break; \
        [ "$i" = "5" ] && exit 1; \
        echo "apt failed… trying again in 10s… " ; sleep 10 ; \
    done

RUN for i in 1 2 3 4 5; do \
        apt-get update \
        && apt-get install -y --no-install-recommends openjdk-11-jdk openjdk-17-jdk \
        && apt-get clean && rm -rf /var/lib/apt/lists/* \
        && break; \
        [ "$i" = "5" ] && exit 1; \
        echo "apt failed… trying again in 10s… " ; sleep 10 ; \
    done

# Debian bullseye does not package JDK 21, so install Eclipse Temurin 21 from a tarball with a verified checksum.
# It is registered with update-alternatives so that .build/docker/_set_java.sh can select it.
RUN sh -c '\
  set -eu ;\
  JDK21_VERSION="21.0.13_9" ;\
  JDK21_TAG="jdk-21.0.13%2B9" ;\
  JDK21_SHA_amd64="d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c" ;\
  JDK21_SHA_arm64="e3522e707fc7dbe2a72c30746b1e7068301a0213ecd213d4491f35a14eb55578" ;\
  case "$(dpkg --print-architecture)" in \
    amd64) JDK21_ARCH=x64 ; JDK21_SHA=$JDK21_SHA_amd64 ;; \
    arm64) JDK21_ARCH=aarch64 ; JDK21_SHA=$JDK21_SHA_arm64 ;; \
    *) echo "Unsupported architecture for Temurin 21" ; exit 1 ;; \
  esac ;\
  curl -fsSL --retry 5 --retry-connrefused --retry-delay 5 --max-time 900 -o /tmp/jdk21.tar.gz "https://github.com/adoptium/temurin21-binaries/releases/download/${JDK21_TAG}/OpenJDK21U-jdk_${JDK21_ARCH}_linux_hotspot_${JDK21_VERSION}.tar.gz" ;\
  echo "${JDK21_SHA}  /tmp/jdk21.tar.gz" | sha256sum -c - ;\
  mkdir -p /usr/lib/jvm/temurin-21 ;\
  tar -xzf /tmp/jdk21.tar.gz -C /usr/lib/jvm/temurin-21 --strip-components=1 ;\
  rm -f /tmp/jdk21.tar.gz ;\
  update-alternatives --install /usr/bin/java java /usr/lib/jvm/temurin-21/bin/java 1 ;\
  update-alternatives --install /usr/bin/javac javac /usr/lib/jvm/temurin-21/bin/javac 1'

RUN update-java-alternatives --set java-1.11.0-openjdk-$(dpkg --print-architecture)

# python3 is needed for the gen-doc target
RUN pip install --upgrade pip

# dependencies for .build/ci/ci_parser.py
RUN pip install beautifulsoup4==4.12.3 jinja2==3.1.3

# Prepopulate Maven repository with dependencies from all branches. see _create_user.sh
COPY docker/_prepopulate_maven_deps.sh /tmp/_prepopulate_maven_deps.sh
RUN mkdir -p /home/image-cache && chmod -R a+rwx /home/image-cache
RUN bash /tmp/_prepopulate_maven_deps.sh /home/image-cache/.m2/repository && rm /tmp/_prepopulate_maven_deps.sh
RUN cp -a /root/.gradle /home/image-cache/.gradle