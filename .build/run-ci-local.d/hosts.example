#
# Hosts for .build/run-ci-local, one per line:
#
#   <ssh host> [<capacity>] [runtime=docker|podman] [arch=amd64|arm64] [home=<directory>]
#
# capacity is in Jenkins agent cpus (cells take small=1, medium=3, large=7), usually the host's core count.
# It is shared by every driver that uses the host, and set when the host has none, else to its core count;
# `run-ci-local set-capacity` replaces it.  The container runtime and the architecture are detected unless
# given.  home is the host's directory for scripts, slots and runs, absolute or relative to the remote home,
# in place of --remote-home.  `localhost` runs cells on this machine without ssh.
#

ci-host-1.example.org 32
ci-host-2.example.org 32 runtime=podman
ci-arm-host.example.org 16 arch=arm64 home=/scratch/run-ci-local
# localhost 8
