#
# Settings for .build/run-ci-local, read from --config, else $RUN_CI_LOCAL_CONFIG, else
# ~/.config/cassandra/run-ci-local.conf.  The command line overrides them, and they override the defaults,
# which for the Jenkins job's parameters are the Jenkinsfile's.  A resumed label keeps the parameters it
# first ran with.  Every key is optional; the values shown are the defaults.
#

[run-ci-local]
# The parameters of the Jenkins job.  Without repository and branch the checkout's commit is tested.
#repository = https://github.com/apache/cassandra
#branch = trunk
#profile = skinny
#profile_custom_regexp =
#architecture = amd64
#jdk =
#dtest_repository = https://github.com/apache/cassandra-dtest
#dtest_branch = trunk

# What failFast does in the Jenkinsfile: a cell that fails its last attempt stops the run.
#fail_fast = yes

# The tool's own settings.
#hosts = ~/.config/cassandra/run-ci-local-hosts
#remote_home = .run-ci-local
#results_dir = build/ci-local
#maven_mirror = https://maven-mirror.example.org/maven2
#timeout_factor = 1
#report = yes
#dtest_dir =
