class OwnerError(HostError):
    pass


class Run:
    """
    One label: its parameters, resolved as the command line, else the parameters a resumed label ran with, else
    the config file, else the Jenkinsfile's defaults; and its cells, stashes and results.
    """

    def __init__(self, args, config):
        self.args = args
        self.config = config
        self.label = check_name(args.label)
        self.results_dir = Path(args.results_dir).expanduser().resolve()
        self.out = self.results_dir / self.label
        self.stash = self.out / "stash"
        self.hosts = load_hosts(args.hosts, args.remote_home)
        self.owner = owner_id(self.results_dir)
        # the label's lock is held from before the state and the stash are read until the run has cleaned up
        self.lock = None
        if not args.dry_run:
            self.lock = lock_label(self.out)
            if self.lock is None:
                raise SystemExit(f"another run-ci-local driver on this machine runs label {self.label}")
            self.out.mkdir(parents=True, exist_ok=True)
        self.dry_run_directory = tempfile.TemporaryDirectory() if args.dry_run else None
        self.state_file = self.out / "state.json"
        self.state = json.loads(self.state_file.read_text()) if self.state_file.exists() else {}
        self.state.setdefault("cells", {})
        self.state.setdefault("stashes", {})
        known = {h.name for h in self.hosts + recorded_hosts(self.hosts, self.state, args.remote_home)}
        for name in set(args.forget_host) - known:
            raise SystemExit(f"--forget-host {name}: not a host of the hosts file, nor one label {self.label} ran on")
        self.state_lock = threading.Lock()
        self.uploaded = {}  # (host, file) -> version
        self.base_ready = {}  # (arch, jdk) -> True once its jar cell built, False when it failed for good
        self.dtest_tar = None
        self.aborting = None  # the cell whose failure stops the run, with fail fast
        self.checked = set()  # hosts checked for the run
        self.ready = set()  # hosts set up for the run, the label claimed there
        # cell -> the attempt whose stop its host has not confirmed, which keeps the cell from starting anywhere
        self.unconfirmed = {}
        self.found_dtest_commit = None
        self.staged = {}  # name -> version of the inputs prepare_inputs made
        self.excluded = {}  # host -> why it cannot run cells
        self.unready = {}  # host -> (when it is tried again, the delay before that, why it is not set up yet)
        self.started = False
        self.foreign = set()  # hosts where the label is not this driver's
        # host -> the hosts, one per remote home, given up on as the label resumed, which stop the label's cells
        # before the host runs one
        self.forgotten = {}
        # this run of the driver: on the hosts, only its starts run cells of the label
        self.session = uuid.uuid4().hex[:16]
        self.parameters = {}
        self.resolve("repository")
        self.resolve("branch")
        self.src = self.checkout()
        self.sha = git(self.src, "rev-parse", "HEAD")
        self.properties = build_properties(self.src, args.maven_mirror)
        self.inputs = inputs_version(self.sha, self.properties)
        self.pipeline = read_pipeline(git_show(self.src, self.sha, ".jenkins/Jenkinsfile"))
        for name in JENKINS_PARAMETERS[2:] + ("fail_fast",):
            self.resolve(name)

    def resolve(self, name):
        """A parameter: the command line, else what the label ran with, else the config file, else the default"""
        given = getattr(self.args, name, None)
        stored = self.state.get("parameters", {})
        # fail fast only decides what happens after a failure, so a resumed label may change it; --force allows
        # the other parameters given to change too, and keeps those not given
        if given is not None and name in stored and given != stored[name] and not self.args.force \
                and name != "fail_fast":
            raise SystemExit(f"label {self.label} ran with {name} {stored[name]!r}; use --force to run it with "
                             f"{given!r}, or a new label")
        if given is not None:
            value = given
        elif name in stored:
            value = stored[name]
        elif name in self.config:
            value = self.config[name]
        elif name in ("repository", "branch"):
            value = None
        elif name == "fail_fast":
            value = SETTING_DEFAULTS["fail_fast"]
        else:
            value = self.pipeline["defaults"][name]
        self.parameters[name] = value

    def checkout(self):
        """
        The checkout to test: this one, or, as Jenkins does, the branch of a repository, fetched into the stash with
        its submodules, or for a dry run into a temporary directory.  Only --branch: of this checkout's upstream
        repository.  Only --repository: this checkout's branch.
        """
        local = Path(self.args.src).resolve()
        repository, branch = self.parameters["repository"], self.parameters["branch"]
        if repository is None and branch is None:
            return local
        if repository is None:
            repository = git_upstream(local)[0] or subprocess.run(
                ["git", "-C", str(local), "remote", "get-url", "origin"], stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, text=True, check=False).stdout.strip()
            if not repository:
                raise SystemExit(f"{local} has no upstream or origin remote; give --repository")
        if branch is None:
            branch = git(local, "rev-parse", "--abbrev-ref", "HEAD")
            if branch == "HEAD":
                raise SystemExit(f"{local} is on no branch; give --branch")
        self.parameters.update(repository=repository, branch=branch)
        source = Path(self.dry_run_directory.name) / "source" if self.args.dry_run else self.stash / "source"
        if not (source / ".git").exists():
            source.mkdir(parents=True, exist_ok=True)
            git(source, "init", "-q")
        log(f"fetching {branch} of {repository}")
        git(source, "fetch", "-q", "--depth=1", "--", repository, branch)
        git(source, "checkout", "-q", "--force", "--detach", "FETCH_HEAD")
        git(source, "submodule", "update", "-q", "--init", "--recursive", "--depth=1")
        return source

    def summary_parameters(self):
        """BUILD_TAG and the build parameters, for ci_summary.html: those Jenkins would have had for this run"""
        repository, branch = self.parameters["repository"], self.parameters["branch"]
        if repository is None:
            repository, branch = git_upstream(self.src)
            repository, branch = repository or "", branch or self.sha
        values = {"BUILD_TAG": f"run-ci-local-{self.label}", "repository": repository, "branch": branch}
        values.update((name, self.parameters[name]) for name in JENKINS_PARAMETERS[2:])
        return {f"SUMMARY_{name}": value for name, value in values.items()}

    def print_parameters(self):
        """As the Jenkinsfile's init stage does"""
        log("Printing parameters used for this build")
        for name in JENKINS_PARAMETERS + ("fail_fast",):
            value = self.parameters[name]
            if name == "repository" and value is None:
                value = f"(this checkout) {self.src}"
            elif name == "branch" and value is None:
                value = f"{git(self.src, 'rev-parse', '--abbrev-ref', 'HEAD')} at {self.sha}"
            log(f"{PARAMETER_TITLES[name]}: {value}")

    def save(self):
        with self.state_lock:
            temporary = self.state_file.with_suffix(".tmp")
            temporary.write_text(json.dumps(self.state, indent=1, sort_keys=True))
            temporary.replace(self.state_file)

    def update(self, cell, **values):
        with self.state_lock:
            self.state["cells"].setdefault(cell.cell_id, {"name": cell.name}).update(values)
        self.save()

    def plan(self):
        """The cells, from the Jenkinsfile and build.xml of the commit that is tested"""
        text = git_show(self.src, self.sha, ".jenkins/Jenkinsfile")
        for function, snippet in jenkinsfile_drift(text):
            log(f"WARNING: .jenkins/Jenkinsfile has changed in code run-ci-local reproduces; its cells may differ "
                f"from Jenkins'. Changed: {function}()" + (f":\n{snippet}" if snippet else ""))
        build_xml = git_show(self.src, self.sha, "build.xml")
        p = self.parameters
        try:
            cells = plan_cells(self.pipeline, build_xml_property(build_xml, "java.default"),
                               build_xml_property(build_xml, "java.supported").split(","), p["profile"],
                               python_regex(p["profile_custom_regexp"], "--profile-custom-regexp"), p["jdk"],
                               self.args.test, p["architecture"])
        except ValueError as e:
            raise SystemExit(str(e)) from e
        if self.args.cells:
            cells_regex = python_regex(self.args.cells, "--cells")
            selected = [c for c in cells if c.kind != "jar" and re.search(cells_regex, c.name)]
            needed = {(c.arch, c.jdk) for c in selected}
            cells = [c for c in cells if c.kind == "jar" and (c.arch, c.jdk) in needed] + selected
        if not cells:
            raise SystemExit("no cells to run")
        return cells

    def load_state(self, cells):
        """
        Starts or resumes the label.  A label that ran before has its cells stopped on every host first; it keeps
        the results it downloaded, and every other cell runs again, or every cell with --force.  A label belongs to
        the commit and build.properties it first ran; after a change, with --allow-sha-change, the earlier results
        move to previous/<version>/ and every cell runs again.
        """
        # check_resume has let it go ahead
        self.stop_earlier_runs(self.state)
        # A change of inputs or --force is recorded before any result is moved or removed, and finished by this
        # run, or by the next one when this one is killed meanwhile
        if self.state.get("transition"):
            self.finish_transition(self.state["transition"])
        previous = self.state.get("inputs")
        if previous and previous != self.inputs:
            # one directory per change, numbered: a label can go back to inputs it ran before
            earlier = [int(p.name.split("-", 1)[0]) for p in (self.out / "previous").glob("*-*")
                       if p.name.split("-", 1)[0].isdigit()] if (self.out / "previous").is_dir() else []
            self.state["transition"] = {"archive": f"{max(earlier, default=0) + 1}-{previous}", "inputs": self.inputs}
        elif self.args.force:
            self.state["transition"] = {"reset": True}
        if self.state.get("transition"):
            self.save()
            self.finish_transition(self.state["transition"])
        for cell_id, entry in self.state["cells"].items():
            # an attempt that was not downloaded is discarded, and does not count
            kept = (entry.get("last_done") or {}).get("attempt")
            if entry.get("status") != "done" and entry.get("attempt") and entry.get("attempt") != kept:
                shutil.rmtree(self.out / "cells" / cell_id / f"attempt{entry['attempt']}", ignore_errors=True)
            if entry.get("status") != "done":
                restore_last_done(entry)
        # the report of an earlier run is not this one's
        for name in REPORT_ARTIFACTS + ("generateTestReports.log.xz", "test/output/combined-result.json"):
            (self.out / name).unlink(missing_ok=True)
        self.state["cells"].pop(ReportCell().cell_id, None)
        # the summary, the report and the exit code are of this run's cells; a report is made of test results
        report = bool(self.args.report) and any(c.kind == "test" for c in cells)
        plan = {c.cell_id: {"name": c.name, "kind": c.kind} for c in cells}
        if report:
            plan[ReportCell().cell_id] = {"name": "report", "kind": "report"}
        self.state.update(sha=self.sha, inputs=self.inputs, src=str(self.src), parameters=self.parameters, plan=plan,
                          report=report)
        self.save()
        (self.out / LABEL_MARKER).touch()

    def finish_transition(self, transition):
        """
        Moves the earlier results to previous/<n>-<inputs>/ for a change of inputs, or removes them for --force;
        each step can be done again
        """
        if "archive" in transition:
            archive = self.out / "previous" / transition["archive"]
            archive.mkdir(parents=True, exist_ok=True)
            if not (archive / "state.json").exists():
                earlier = {k: v for k, v in self.state.items() if k != "transition"}
                (archive / "state.json.tmp").write_text(json.dumps(earlier, indent=1, sort_keys=True))
                os.replace(archive / "state.json.tmp", archive / "state.json")
            for name in ("cells", "summary.txt", "ci_summary.html", "results_details.tar.xz",
                         "generateTestReports.log.xz", "test"):
                if (self.out / name).exists():
                    os.replace(self.out / name, archive / name)
            for name in os.listdir(self.stash) if self.stash.is_dir() else []:
                # the fetched checkout, and this run's inputs
                if name not in ("source", "next"):
                    path = self.stash / name
                    shutil.rmtree(path) if path.is_dir() else path.unlink()
            log(f"{self.label}: inputs changed; the results of {self.state.get('sha')} are in {archive}")
            self.state = {"cells": {}, "stashes": {}, "hosts": self.state.get("hosts", {})}
        else:
            shutil.rmtree(self.out / "cells", ignore_errors=True)
            self.state["cells"] = {}
        self.save()

    # ---- inputs

    def prepare_inputs(self, cells):
        """
        This run's src.tar, and dtest.tar for python dtests, made and checked in stash/next/ before anything of an
        earlier run of the label is stopped or changed; install_inputs puts them in place
        """
        if self.src == Path(self.args.src).resolve() and git(self.src, "status", "--porcelain", "--untracked-files=no"):
            log("WARNING: the checkout has uncommitted changes; only the committed HEAD is tested")
        staged = self.stash / "next"
        shutil.rmtree(staged, ignore_errors=True)
        staged.mkdir(parents=True)
        self.staged = {}
        keep = not self.replaces_results()
        if not (keep and (self.stash / "src.tar").exists() and self.state["stashes"].get("src.tar") == self.inputs):
            log(f"creating the source tarball of {self.src} at {self.sha[:10]}")
            if self.parameters["repository"] is not None:
                branch, repository, remote_branch = self.parameters["branch"], self.parameters["repository"], None
            else:
                branch = None
                repository, remote_branch = git_upstream(self.src)
            write_source_tarball(self.src, self.sha, staged / "src.tar", self.properties, branch, repository,
                                 remote_branch)
            self.staged["src.tar"] = self.inputs
        if not any(c.command.get("python-dtest") for c in cells):
            return
        commit = self.dtest_commit()
        self.dtest_tar = self.stash / "dtest.tar"
        if keep and self.dtest_tar.exists() and self.state["stashes"].get("dtest.tar") == commit:
            return
        if self.args.dtest_dir:
            checkout = Path(self.args.dtest_dir).resolve()
            self.check_dtest_dir(commit)
        else:
            checkout = staged / "cassandra-dtest"
            checkout.mkdir()
            log(f"fetching {commit} of {self.parameters['dtest_repository']}")
            git(checkout, "init", "-q")
            git(checkout, "fetch", "-q", "--depth=1", "--", self.parameters["dtest_repository"], commit)
            git(checkout, "checkout", "-q", "--detach", "FETCH_HEAD")
            if not (checkout / "requirements.txt").exists():
                raise SystemExit(f"{commit} of {self.parameters['dtest_repository']} is not a cassandra-dtest "
                                 f"checkout")
        subprocess.run(["git", "-C", str(checkout), "archive", "--format=tar", "-o", str(staged / "dtest.tar"),
                        commit], check=True)
        if not self.args.dtest_dir:
            shutil.rmtree(checkout, ignore_errors=True)
        self.staged["dtest.tar"] = commit

    def install_inputs(self):
        """Puts the inputs prepare_inputs made in the stash, as the label's"""
        for name, version in self.staged.items():
            os.replace(self.stash / "next" / name, self.stash / name)
            self.state["stashes"][name] = version
            if name == "dtest.tar":
                self.state.update(dtest_commit=version,
                                  dtest_source=str(self.args.dtest_dir or self.parameters["dtest_repository"]))
        shutil.rmtree(self.stash / "next", ignore_errors=True)
        self.save()

    def dtest_commit(self):
        """
        The commit of the python dtests: the one the label ran, else the head of --dtest-dir, else that of the
        dtest branch, which a resumed label keeps unless given --force or --allow-sha-change with other inputs
        """
        if self.found_dtest_commit:
            return self.found_dtest_commit
        self.found_dtest_commit = self.find_dtest_commit()
        return self.found_dtest_commit

    def find_dtest_commit(self):
        if self.state.get("dtest_commit") and not self.args.force and not self.replaces_results():
            return self.state["dtest_commit"]
        if self.args.dtest_dir:
            return git(Path(self.args.dtest_dir).resolve(), "rev-parse", "HEAD")
        repository, branch = self.parameters["dtest_repository"], self.parameters["dtest_branch"]
        listing = subprocess.run(["git", "ls-remote", "--", repository, f"refs/heads/{branch}", f"refs/tags/{branch}"],
                                 stdout=subprocess.PIPE, text=True, check=True).stdout.split()
        if listing:
            return listing[0]
        if re.fullmatch(r"[0-9a-f]{40}", branch):
            return branch
        raise SystemExit(f"no branch {branch} in {repository}")

    def check_dtest_dir(self, commit):
        checkout = Path(self.args.dtest_dir).resolve()
        if not (checkout / "requirements.txt").exists():
            raise SystemExit(f"{checkout} is not a cassandra-dtest checkout")
        if git(checkout, "rev-parse", "HEAD") != commit:
            raise SystemExit(f"label {self.label} ran the dtests at {commit}, {checkout} is at another commit; "
                             f"use --force to run it with that one")

    def check_host(self, host):
        """
        Installs and checks a host, and whether the label there may be this driver's, without touching it; True
        when it can run cells.  A host that does not answer is tried again later; one that answers but cannot run
        cells is left out.
        """
        if host.name in self.checked:
            return True
        if host.name in self.excluded or time.time() < self.unready.get(host.name, (0, 0, ""))[0]:
            return False
        try:
            host.remote.install(host)
            host.arch = host.arch or host.run(host.remote.job("arch")).stdout.decode().strip()
            # the runtime its cells use, which their attempts record
            host.runtime = host.runtime or (host.run(host.remote.job("runtime")).stdout.decode().split() or [None])[0]
            result = host.run(host.remote.job("owner", self.label, self.owner), check=False)
            self.claim_refused(host, result)
        except HostError as e:
            return self.not_set_up(host, e)
        self.checked.add(host.name)
        return True

    def setup_host(self, host):
        """A checked host where the label has been claimed for this run; True when it can run cells"""
        if host.name in self.ready:
            return True
        if not self.check_host(host):
            return False
        try:
            # given up on as the label resumed: what it still runs of the label, under any remote home, is stopped
            # before it runs more
            for skipped in list(self.forgotten.get(host.name, [])):
                self.stop_label_on(skipped)
                self.forgotten[host.name].remove(skipped)
            self.claim(host)
        except HostError as e:
            self.checked.discard(host.name)
            return self.not_set_up(host, e)
        self.ready.add(host.name)
        return True

    def not_set_up(self, host, error):
        """False, for a host that cannot run cells now: left out, or tried again later"""
        if isinstance(error, ClaimError):
            if not self.started:
                raise SystemExit(f"{error}; use another label") from error
            self.foreign.add(host.name)
        if isinstance(error, (ClaimError, PreflightError)):
            log(f"WARNING: {error}; it is left out")
            self.excluded[host.name] = str(error)
        else:
            self.back_off(host, error)
        return False

    @staticmethod
    def claim_refused(host, result):
        """ClaimError or PreflightError for a label directory that is not this driver's to have"""
        if result.returncode == NOT_OWNER:
            raise ClaimError(f"{host}: {result.stderr.decode(errors='replace').strip()}")
        if result.returncode == LABEL_DIR_UNUSABLE:
            raise PreflightError(f"{host}: {result.stderr.decode(errors='replace').strip()}")
        if result.returncode != 0:
            raise HostError(f"{host}: {result.stderr.decode(errors='replace').strip()}")

    def back_off(self, host, error):
        """A host that does not answer is tried again after a delay that doubles each time, up to a maximum"""
        delay = self.unready.get(host.name, (0, 0, ""))[1]
        delay = min(delay * 2, HOST_RETRY_MAX_SECONDS) if delay else HOST_RETRY_SECONDS
        self.unready[host.name] = (time.time() + delay, delay, str(error))
        log(f"WARNING: {host} cannot be set up yet, and is tried again in {delay}s: {error}")

    def claim(self, host):
        """
        Makes the label's directory on the host this driver's, and records the host as one the label runs on;
        ClaimError when it is not this driver's to have
        """
        result = host.run(host.remote.job("claim", self.label, self.owner, self.session), check=False)
        if result.returncode == FENCED:
            # this driver's label of a run whose state is gone: taken over as a resume does
            self.stop_label_on(host)
            result = host.run(host.remote.job("claim", self.label, self.owner, self.session), check=False)
        self.claim_refused(host, result)
        with self.state_lock:
            self.state.setdefault("hosts", {})[f"{host.name} {host.remote.given_home}"] = {
                "host": host.name, "home": host.remote.given_home, "runtime": host.runtime,
                "version": host.remote.version}
        self.save()

    def stop_label_on(self, host):
        """
        Stops every cell of the label on the host, waits until none runs, and discards what they left; only this
        run starts cells of the label there after.  HostError while the host does not answer.
        """
        host.remote.install(host, preflight=False)
        result = host.run(host.remote.job("kill", self.label, self.owner, self.session), check=False, timeout=600)
        if result.returncode == LABEL_DIR_UNUSABLE:
            # holds nothing of this driver's
            log(f"WARNING: {host}: {result.stderr.decode(errors='replace').strip()}")
            return
        if result.returncode not in (0, NOT_OWNER):
            raise HostError(f"{host}: stopping the cells of {self.label} failed: "
                            f"{result.stderr.decode(errors='replace').strip()}")
        stopped = result.stdout.decode().strip()
        if result.returncode == 0 and stopped not in ("", "0"):
            log(f"{host}: stopped {stopped} running cells of {self.label}, which run again")

    def stop_earlier_runs(self, state):
        """
        A label that ran before: its cells are stopped on the hosts of the hosts file and on those it ran on before
        anything starts, waiting for a host that does not answer unless --forget-host gives it up
        """
        if not state.get("cells") and not state.get("hosts"):
            return
        waiting = {(h.name, h.remote.given_home): h
                   for h in self.hosts + recorded_hosts(self.hosts, state, self.args.remote_home)}
        delay = 0
        while True:
            errors = {}
            for key, host in list(waiting.items()):
                if host.name in self.args.forget_host:
                    log(f"WARNING: {host} is not asked to stop the cells of {self.label} under {key[1]} "
                        f"(--forget-host); it stops them before it runs one")
                    self.forgotten.setdefault(host.name, []).append(host)
                    del waiting[key]
                    continue
                try:
                    self.stop_label_on(host)
                    del waiting[key]
                except HostError as e:
                    errors[key] = e
            if not waiting:
                return
            delay = min(delay * 2, HOST_RETRY_MAX_SECONDS) if delay else HOST_RETRY_SECONDS
            log(f"WARNING: no cell of {self.label} starts while one may still run on "
                f"{', '.join(sorted(h.name for h in waiting.values()))}; asking again in {delay}s, or give up on a "
                f"host with --forget-host <host>: {'; '.join(str(e) for e in errors.values())}")
            time.sleep(delay)

    def upload(self, host, path, name, version):
        """Copies a stash to the host's run directory, unless the host has this version of it"""
        if self.uploaded.get((host.name, name)) == version:
            return
        target = host.remote.run_dir(self.label, name)
        if host.run(f"cat {target}.version 2>/dev/null", check=False).stdout.decode().strip() != version:
            log(f"uploading {name} to {host}")
            with open(path, "rb") as handle:
                self.put(host, name, os.fstat(handle.fileno()).st_size, version, stdin=handle,
                         timeout=TRANSFER_TIMEOUT)
        self.uploaded[(host.name, name)] = version

    def put(self, host, name, size, version=None, **run_args):
        """
        Writes a file of the label's directory on the host through job.sh, which takes it only from this run of the
        driver, and only whole
        """
        result = host.run(host.remote.job("put", self.label, self.session, name, size, *([version] if version else [])),
                          check=False, **run_args)
        if result.returncode == FENCED:
            raise OwnerError(f"{host}: {result.stderr.decode(errors='replace').strip()}; stopping")
        if result.returncode != 0:
            raise HostError(f"{host}: writing {name} failed: {result.stderr.decode(errors='replace').strip()}")

    def inputs_for(self, cell):
        """The stashes a cell needs: (local path, remote name, version), or None while one is not ready yet"""
        if cell.kind in ("jar", "report"):
            needed = [(self.stash / "src.tar", "src.tar", self.inputs)]
        else:
            version = self.state["stashes"].get(cell.base, "")
            if not self.base_ready.get((cell.arch, cell.jdk)) or not version.startswith(self.inputs + "-"):
                return None
            needed = [(self.stash / cell.base, cell.base, version)]
        if cell.command.get("python-dtest"):
            needed.append((self.dtest_tar, "dtest.tar", self.state["stashes"]["dtest.tar"]))
        if cell.kind == "report":
            needed.append((self.stash / "report-input.tar", "report-input.tar", self.state["report_input"]))
        return needed

    # ---- cells

    def try_start(self, cell, host, attempt_id, reserve=False):
        """
        Starts an attempt of the cell; False when the host is full, or an earlier attempt of the cell still runs
        there.  PrestartError when the host fails before the start, HostError when the start may have gone out
        without an answer, and OwnerError when another driver, or another run of this one, has taken the label.
        """
        inputs = self.inputs_for(cell)
        if inputs is None:
            return False
        extra = self.summary_parameters() if cell.kind == "report" else None
        try:
            for path, name, version in inputs:
                self.upload(host, path, name, version)
            # fail fast may have stopped the run while the stashes went up
            if self.aborting is not None and cell.kind != "report":
                return False
            env = cell.env(self.args.timeout_factor, host.runtime, extra).encode()
            self.put(host, f"jobs/{cell.cell_id}.env", len(env), input_bytes=env)
        except OwnerError:
            raise
        except HostError as e:
            raise PrestartError(str(e)) from e
        result = host.run(host.remote.job("start", self.label, cell.cell_id, cell.units, self.owner, attempt_id,
                                          self.session, *(["reserve"] if reserve else [])), check=False)
        if result.returncode in (HOST_FULL, RUNNER_ALIVE):
            return False
        if result.returncode in (NOT_OWNER, FENCED):
            raise OwnerError(f"{host}: {result.stderr.decode(errors='replace').strip()}; stopping")
        if result.returncode == SSH_FAILED:
            raise HostError(f"starting {cell.name} on {host}: {result.stderr.decode(errors='replace')}")
        if result.returncode != 0:
            raise PrestartError(f"starting {cell.name} on {host} failed: {result.stderr.decode(errors='replace')}")
        return True

    def stop(self, cell, host, attempt_id):
        """
        Stops the attempt, and keeps it from starting later: "stopped" when it ran, "finished" when it had ended,
        "not running", or None when the host does not answer
        """
        try:
            result = host.run(host.remote.job("stop", self.label, cell.cell_id, attempt_id), timeout=600)
            return result.stdout.decode().strip()
        except HostError as e:
            log(str(e))
            return None

    def wait(self, cell, host, attempt_id, deadline):
        """The exit code of a started cell, or None when it is lost, past its deadline, or the host is unreachable"""
        lost = failures = 0
        while True:
            try:
                status = host.run(host.remote.job("status", self.label, cell.cell_id, attempt_id))
                status = status.stdout.decode().split()
                failures = 0
            except HostError as e:
                failures += 1
                log(f"status of {cell.name} on {host} ({failures}): {e}")
                if failures >= SSH_FAILURES_LOST:
                    return None
                time.sleep(20)
                continue
            # a finished attempt is read whatever the time; the deadline is for one still running
            if status and status[0] == "done":
                return int(status[1])
            if time.time() > deadline:
                log(f"{cell.name} on {host} is past its deadline; stopping it")
                self.stop(cell, host, attempt_id)
                return None
            lost = lost + 1 if status and status[0] in ("lost", "unknown") else 0
            if lost >= 3:
                return None
            time.sleep(20)

    def fetch(self, cell, host, attempt, attempt_id):
        """The cell's result, into cells/<cell>/attempt<N>/; False when it is missing or unreadable"""
        destination = self.out / "cells" / cell.cell_id / f"attempt{attempt}"
        shutil.rmtree(destination, ignore_errors=True)
        destination.mkdir(parents=True)
        result_tar = destination.parent / f"attempt{attempt}.result.tar"
        try:
            with open(result_tar, "wb") as handle:
                copied = host.run(f"cat {host.remote.run_dir(self.label, 'jobs', cell.cell_id + '.result.tar')}",
                                  check=False, stdout=handle, timeout=TRANSFER_TIMEOUT)
            if copied.returncode != 0:
                return False
            with tarfile.open(result_tar) as tar:
                for member in tar:
                    if member.name.startswith("out/"):
                        member.name = member.name[len("out/"):]
                        extract_member(tar, member, destination)
        except (tarfile.TarError, OSError, EOFError) as e:
            log(f"the result of {cell.name} from {host} is unreadable: {e}")
            return False
        finally:
            result_tar.unlink(missing_ok=True)
        rc = (destination / "rc").read_text().strip() if (destination / "rc").exists() else ""
        if not rc:
            return False
        if cell.kind == "jar" and rc == "0":
            base = self.stash / cell.base
            with open(str(base) + ".tmp", "wb") as handle:
                copied = host.run(f"cat {host.remote.run_dir(self.label, cell.base)}", check=False, stdout=handle,
                                  timeout=TRANSFER_TIMEOUT)
            if copied.returncode != 0 or not tarfile.is_tarfile(str(base) + ".tmp"):
                return False
            os.replace(str(base) + ".tmp", base)
            # the base of this attempt: the cells that start from it ask for this version
            version = f"{self.inputs}-{attempt_id}"
            marked = host.run(host.remote.job("mark", self.label, self.session, cell.base, version), check=False)
            if marked.returncode != 0:
                log(f"{host}: {marked.stderr.decode(errors='replace').strip()}")
                return False
            self.uploaded[(host.name, cell.base)] = version
            with self.state_lock:
                self.state["stashes"][cell.base] = version
            self.save()
        compress(destination)
        if cell.kind == "report":
            # as the Jenkinsfile archives it, next to ci_summary.html
            shutil.copy2(destination / "stage.log.xz", self.out / "generateTestReports.log.xz")
            # the report of a successful attempt, both files of it, or none
            if rc == "0" and report_made(destination):
                for name in REPORT_ARTIFACTS:
                    shutil.copy2(destination / name, self.out / (name + ".tmp"))
                for name in REPORT_ARTIFACTS:
                    os.replace(self.out / (name + ".tmp"), self.out / name)
        if cell.kind == "test":
            duration = int((destination / "duration_s").read_text().strip() or 0) * 1000 \
                if (destination / "duration_s").exists() else 0
            outcome = "ok" if rc == "0" else "timeout" if rc in ("124", "137") else "failed"
            tsv, suites = cell_times(cell, duration, outcome, destination / "output")
            (destination / "cell-time.tsv").write_text(tsv)
            (destination / "cell-time.suites").write_text(suites)
        return True

    def run_cell(self, cell, host, attempt, attempt_id, deadline):
        """Waits for a started cell and fetches it.  True when it succeeded and needs no retry."""
        started = time.time()
        rc = self.wait(cell, host, attempt_id, deadline)
        fetched = rc is not None and self.fetch(cell, host, attempt, attempt_id)
        if rc is None and self.stop(cell, host, attempt_id) is None:
            # a lost attempt may still run: the cell is not tried again, anywhere, until it has stopped
            self.unconfirmed[cell.cell_id] = unconfirmed_stop(host, attempt_id)
        junit = len(junit_files(self.out / "cells" / cell.cell_id / f"attempt{attempt}" / "output")) if fetched else 0
        duration = int(time.time() - started)
        status = "done" if fetched else "lost"
        with self.state_lock:
            entry = self.state["cells"].setdefault(cell.cell_id, {"name": cell.name})
            entry.update(host=host.name, rc=rc, status=status, attempt=attempt, duration_s=duration, junit=junit,
                         finished=datetime.datetime.now().isoformat(timespec="seconds"),
                         **({"artifacts": report_made(self.out)} if cell.kind == "report" else {}))
            if fetched:
                # what a resumed label keeps of the cell
                entry["done_attempts"] = entry.get("done_attempts", 0) + 1
                entry["last_done"] = {k: v for k, v in entry.items() if k not in NOT_A_RESULT}
        self.save()
        if fetched:
            # the result is kept here and in state.json before the host forgets it; a failure to clean up after
            # that leaves files behind, and the result as it is
            try:
                result = host.run(host.remote.job("clean", self.label, cell.cell_id, attempt_id, self.session),
                                  check=False)
                if result.returncode != 0:
                    log(f"cleaning up {cell.name} on {host} failed with {result.returncode}: "
                        f"{result.stderr.decode(errors='replace').strip()}")
            except HostError as e:
                log(f"cleaning up {cell.name} on {host}: {e}")
        note = " no test results" if fetched and cell.kind == "test" and not junit else ""
        if cell.kind == "report" and not report_made(self.out):
            note = " no report"
        log(f"FINISHED {cell.name} on {host}: rc={rc} {status}{note} in {duration // 60}m{duration % 60:02d}s")
        return cell_succeeded(self.state["cells"][cell.cell_id], cell.kind)

    def host_free(self):
        """{host: (free units, capacity)}, (0, 0) for a host that does not answer"""
        free = {}
        for host in self.hosts:
            if not self.setup_host(host):
                free[host.name] = (0, 0)
                continue
            try:
                units, capacity = host.run(host.remote.job("capacity"), timeout=60).stdout.decode().split()
                free[host.name] = (int(units), int(capacity))
                # answering in full: the next time it does not, it is tried again after the first delay
                self.unready.pop(host.name, None)
            except (HostError, ValueError) as e:
                # set up again once it answers
                self.ready.discard(host.name)
                self.back_off(host, e)
                free[host.name] = (0, 0)
        return free

    def finished(self, cell):
        """A cell that succeeded, or that failed on its last attempt; --force resets"""
        entry = self.state["cells"].get(cell.cell_id, {})
        if self.args.force:
            return False
        return (cell_succeeded(entry, cell.kind)
                or (entry.get("status") == "done" and entry.get("done_attempts", 0) >= MAX_ATTEMPTS))

    def schedule(self, cells):
        """
        Runs the cells on the hosts of their architecture with free capacity, retrying a failed or lost cell once,
        on another host when one has room.  With fail fast, as in the Jenkinsfile, the other cells wait for the jar
        cells, and a cell that fails its last attempt stops the run.  A start that went out without an answer is
        stopped on its host before the cell starts anywhere else.
        """
        pending = [c for c in cells if not self.finished(c)]
        for cell in cells:
            if cell.kind == "jar" and self.finished(cell):
                if (cell_succeeded(self.state["cells"][cell.cell_id], "jar") and (self.stash / cell.base).exists()
                        and self.state["stashes"].get(cell.base, "").startswith(self.inputs + "-")):
                    self.base_ready[(cell.arch, cell.jdk)] = True
                elif cell_succeeded(self.state["cells"][cell.cell_id], "jar"):
                    if any((c.arch, c.jdk) == (cell.arch, cell.jdk) and c.kind in ("build", "test") for c in pending):
                        # the stashes of a finished run are gone: build again
                        self.update(cell, status="not run", rc=None, done_attempts=0, last_done=None)
                        pending.append(cell)
                else:
                    self.base_ready[(cell.arch, cell.jdk)] = False
                    if self.parameters["fail_fast"] and self.aborting is None:
                        # as the run it resumes did, a jar cell that failed stops this one
                        self.aborting = cell.name
        # jar cells first, the largest cells next, python dtests last
        pending.sort(key=lambda c: (c.kind != "jar", bool(c.command.get("python-dtest")), -c.units, c.step, c.split))
        attempts, lost, last_host, waiting_since, reserved_on, running = {}, {}, {}, {}, {}, {}
        start_failures, unreachable_since, failed_on = {}, {}, {}
        unconfirmed = self.unconfirmed
        stopped = set()  # the attempts fail fast interrupted
        pending_lock = threading.Lock()
        warned = set()
        stopping = False

        def counted(cell):
            """The attempts that count towards the cell's two: those downloaded, and those lost in this run"""
            return self.state["cells"].get(cell.cell_id, {}).get("done_attempts", 0) + lost.get(cell.cell_id, 0)

        def failed_for_good(cell):
            if cell.kind == "jar":
                self.base_ready[(cell.arch, cell.jdk)] = False
            if self.parameters["fail_fast"] and cell.kind != "report" and self.aborting is None:
                self.aborting = cell.name

        def stop_unconfirmed(cell):
            """
            True once the attempt whose stop is not confirmed, a start that went out without an answer or a lost
            attempt, has stopped on its host, or there is none, or its host is given to --forget-host.  The host is
            asked again after a delay that doubles each time.
            """
            waiting = unconfirmed.get(cell.cell_id)
            if waiting is None:
                return True
            host, attempt_id = waiting["host"], waiting["attempt_id"]
            if host.name in self.args.forget_host:
                log(f"WARNING: {cell.name}: attempt {attempt_id} on {host} is not waited for (--forget-host)")
                del unconfirmed[cell.cell_id]
                return True
            if time.time() < waiting["retry_at"]:
                return False
            if self.stop(cell, host, attempt_id) is None:
                delay = min(waiting["delay"] * 2, HOST_RETRY_MAX_SECONDS) if waiting["delay"] else HOST_RETRY_SECONDS
                waiting.update(retry_at=time.time() + delay, delay=delay)
                log(f"{cell.name} waits for {host} to confirm that attempt {attempt_id} has stopped; asking again "
                    f"in {delay}s, or give up on the host with --forget-host {host}")
                return False
            del unconfirmed[cell.cell_id]
            return True

        def keep_result(cell, status):
            """The cell's entry, once its attempts are over: its last downloaded result, else the status"""
            with self.state_lock:
                entry = self.state["cells"].setdefault(cell.cell_id, {"name": cell.name})
                entry["kind"] = cell.kind
                if entry.get("status") != "done":
                    if entry.get("last_done"):
                        restore_last_done(entry)
                    else:
                        entry.update(status=status, rc=None)
            self.save()

        def not_run(cell):
            """A cell taken out of pending that will not run; an earlier result it has stands"""
            if cell.cell_id in unconfirmed:
                waiting = unconfirmed.pop(cell.cell_id)
                self.stop(cell, waiting["host"], waiting["attempt_id"])
            keep_result(cell, "not run")

        def launch(cell, host, attempt, attempt_id):
            attempts[cell.cell_id] = attempt
            last_host[cell.cell_id] = host.name
            deadline = time.time() + cell.timeout_hours * self.args.timeout_factor * 3600 + DEADLINE_MARGIN_SECONDS
            self.update(cell, status="running", kind=cell.kind, **attempt_record(host, attempt, attempt_id))
            log(f"STARTED {cell.name} on {host} (attempt {attempt})")
            if self.aborting is not None and cell.kind != "report":
                # started as fail fast stopped the run
                stop_for_fail_fast(cell, host, attempt_id)

            def follow():
                try:
                    ok = self.run_cell(cell, host, attempt, attempt_id, deadline)
                except Exception as e:  # pylint: disable=broad-except
                    log(f"{cell.name} on {host}: {type(e).__name__}: {e}")
                    self.update(cell, status="lost", rc=None, host=host.name, attempt=attempt)
                    ok = False
                if attempt_id in stopped:
                    # interrupted by fail fast, which Jenkins does not retry either: the attempt does not count, and
                    # an earlier result of the cell stands
                    keep_result(cell, "aborted")
                    return
                if self.state["cells"][cell.cell_id].get("status") == "lost":
                    lost[cell.cell_id] = lost.get(cell.cell_id, 0) + 1
                    # a result downloaded earlier stands for the cell until another is
                    keep_result(cell, "lost")
                if ok:
                    if cell.kind == "jar":
                        self.base_ready[(cell.arch, cell.jdk)] = True
                elif self.aborting is not None:
                    # no retry once fail fast has stopped the run; the cell keeps its failure
                    pass
                elif counted(cell) < MAX_ATTEMPTS:
                    log(f"RETRY {cell.name}")
                    with pending_lock:
                        pending.insert(0, cell)
                else:
                    failed_for_good(cell)
            thread = threading.Thread(target=follow, daemon=True)
            thread.start()
            running[cell.cell_id] = (thread, cell, host, attempt_id)

        def stop_for_fail_fast(cell, host, attempt_id):
            # an attempt that had ended keeps its own result
            if self.stop(cell, host, attempt_id) == "stopped":
                stopped.add(attempt_id)

        def next_attempt(cell):
            """The next attempt's number, above those of the attempts kept"""
            if cell.cell_id in attempts:
                return attempts[cell.cell_id] + 1
            directory = self.out / "cells" / cell.cell_id
            numbers = [int(p.name[len("attempt"):]) for p in directory.glob("attempt*")
                       if p.is_dir() and p.name[len("attempt"):].isdigit()] if directory.is_dir() else []
            return max(numbers, default=0) + 1

        def give_up(cell, why, status):
            log(f"{status.upper()} {cell.name}: {why}")
            with pending_lock:
                pending.remove(cell)
            not_run(cell)
            keep_result(cell, status)
            failed_for_good(cell)

        def start_attempt(cell, host, reserve):
            attempt = next_attempt(cell)
            attempt_id = f"{attempt}-{uuid.uuid4().hex[:12]}"
            try:
                started = self.try_start(cell, host, attempt_id, reserve)
            except PrestartError:
                raise
            except HostError:
                unconfirmed[cell.cell_id] = unconfirmed_stop(host, attempt_id)
                raise
            if started:
                launch(cell, host, attempt, attempt_id)
            return started

        while True:
            for cell_id in [i for i, (t, _, _, _) in running.items() if not t.is_alive()]:
                del running[cell_id]
            if self.aborting is not None:
                # as failFast in the Jenkinsfile: the other cells are interrupted, and none starts
                with pending_lock:
                    dropped = list(pending)
                    pending.clear()
                for cell in dropped:
                    not_run(cell)
                if not stopping:
                    stopping = True
                    log(f"FAIL FAST: {self.aborting} failed; stopping the other cells (--no-fail-fast runs them all)")
                    for _, cell, host, attempt_id in list(running.values()):
                        stop_for_fail_fast(cell, host, attempt_id)
            with pending_lock:
                # cells whose jar cell failed for good
                dropped = [c for c in pending if c.kind not in ("jar", "report")
                           and self.base_ready.get((c.arch, c.jdk)) is False]
                for cell in dropped:
                    pending.remove(cell)
                waiting = list(pending)
            for cell in dropped:
                not_run(cell)
                log(f"NOT RUN {cell.name}: the jar cell of {cell.arch} jdk{cell.jdk} failed")
            if not waiting and not running:
                return
            # with fail fast, as the jar stage of the Jenkinsfile, every jar cell finishes before any other starts
            jars_running = (any(c.kind == "jar" for c in waiting)
                            or any(c.kind == "jar" for _, c, _, _ in running.values()))
            free = self.host_free() if waiting else {}
            started = False
            for cell in waiting:
                if self.aborting is not None:
                    break
                if self.inputs_for(cell) is None or (self.parameters["fail_fast"] and jars_running
                                                     and cell.kind != "jar"):
                    continue
                if not stop_unconfirmed(cell):
                    entry = unconfirmed[cell.cell_id]
                    if time.time() - entry["since"] >= HOSTS_UNREACHABLE_SECONDS:
                        give_up(cell, f"{entry['host']} has not confirmed for an hour that attempt "
                                      f"{entry['attempt_id']} has stopped", "unstartable")
                    continue
                waiting_since.setdefault(cell.cell_id, time.time())
                hosts = [h for h in self.hosts if cell.kind == "report" or h.arch == cell.arch]
                answering = [h for h in hosts if free[h.name][1]]
                if not answering:
                    # a host that does not answer may come back: the cell waits, but not for ever
                    waited = time.time() - unreachable_since.setdefault(cell.cell_id, time.time())
                    if waited >= HOSTS_UNREACHABLE_SECONDS:
                        give_up(cell, "no host of its architecture has answered for an hour", "unstartable")
                    continue
                unreachable_since.pop(cell.cell_id, None)
                # a host smaller than the cell only when no host is large enough
                eligible = [h for h in answering if free[h.name][1] >= cell.units]
                if not eligible:
                    eligible = answering
                    if cell.cell_id not in warned:
                        warned.add(cell.cell_id)
                        log(f"WARNING: no host has the {cell.units} units {cell.name} takes; it runs on a smaller one")
                # Jenkins retries on another agent; a host that failed to start the cell comes last
                candidates = sorted((h for h in eligible if free[h.name][0] >= min(cell.units, free[h.name][1])),
                                    key=lambda h: (h.name in failed_on.get(cell.cell_id, ()),
                                                   h.name == last_host.get(cell.cell_id),
                                                   -free[h.name][0] / free[h.name][1]))
                reserve = not candidates and time.time() - waiting_since[cell.cell_id] > RESERVE_AFTER_SECONDS
                if reserve:
                    candidates = [max(eligible, key=lambda h: free[h.name])]
                failed = False
                for host in candidates:
                    try:
                        if not start_attempt(cell, host, reserve):
                            if reserve:
                                reserved_on[cell.cell_id] = host
                            continue
                    except OwnerError as e:
                        raise SystemExit(str(e)) from e
                    except HostError as e:
                        log(f"{cell.name} cannot start on {host}: {e}")
                        failed = True
                        failed_on.setdefault(cell.cell_id, set()).add(host.name)
                        start_failures[cell.cell_id] = start_failures.get(cell.cell_id, 0) + 1
                        if start_failures[cell.cell_id] >= START_FAILURE_LIMIT:
                            give_up(cell, f"hosts failed to start it {START_FAILURE_LIMIT} times in a row",
                                    "unstartable")
                            break
                        if cell.cell_id in unconfirmed:
                            # the start may have gone out: it is stopped there before the cell starts elsewhere
                            break
                        continue
                    free[host.name] = (free[host.name][0] - cell.units, free[host.name][1])
                    with pending_lock:
                        pending.remove(cell)
                    waiting_since.pop(cell.cell_id, None)
                    start_failures.pop(cell.cell_id, None)
                    failed_on.pop(cell.cell_id, None)
                    reserved = reserved_on.pop(cell.cell_id, None)
                    if reserved is not None and reserved is not host:
                        try:
                            reserved.run(reserved.remote.job("unreserve", self.label, cell.cell_id))
                        except HostError as e:
                            log(str(e))
                    started = True
                    break
                else:
                    if candidates and not failed:
                        start_failures.pop(cell.cell_id, None)
            time.sleep(5 if started else 20)

    def combine_jmh_results(self):
        """test/output/combined-result.json from the cells' jmh-result.json, as processJmhReports() writes it"""
        results = []
        for cell_id in sorted(self.state.get("plan", [])):
            attempt = recorded_attempt(self.out, cell_id, self.state["cells"].get(cell_id))
            for path in sorted((attempt / "output").rglob("jmh-result.json")) if attempt else []:
                data = json.loads(path.read_text())
                results.extend(data if isinstance(data, list) else [data])
        if results:
            combined = self.out / "test" / "output" / "combined-result.json"
            combined.parent.mkdir(parents=True, exist_ok=True)
            combined.write_text(json.dumps(results))
            log(f"combined {len(results)} jmh results into {combined}")

    def report(self):
        """ci_summary.html and results_details.tar.xz, made on a host as the Jenkinsfile's generateTestReports() does"""
        report_input = self.stash / "report-input.tar"
        added = 0
        report_cell = ReportCell()
        with tarfile.open(str(report_input) + ".tmp", "w") as tar:
            for cell_id in sorted(c for c in self.state.get("plan", []) if c != report_cell.cell_id):
                attempt = recorded_attempt(self.out, cell_id, self.state["cells"].get(cell_id))
                if attempt is None:
                    continue
                if (attempt / "output").is_dir():
                    for path in sorted((attempt / "output").rglob("*")):
                        if path.is_file():
                            tar.add(str(path), arcname=f"test/output/{path.relative_to(attempt / 'output')}")
                            added += 1
                for extension in ("tsv", "suites"):
                    if (attempt / f"cell-time.{extension}").exists():
                        tar.add(str(attempt / f"cell-time.{extension}"),
                                arcname=f"test/cell-times/{cell_id}.{extension}")
        if not added:
            os.unlink(str(report_input) + ".tmp")
            log("no test results; no report")
            return
        os.replace(str(report_input) + ".tmp", report_input)
        self.state["report_input"] = file_digest(report_input)
        # made again by every run
        self.state["cells"].pop(report_cell.cell_id, None)
        self.save()
        self.schedule([report_cell])

    def execute(self):
        """Runs the label; returns the exit code of its result"""
        self.print_parameters()
        cells = self.plan()
        log(f"label {self.label}: {len(cells)} cells from {self.src} at {self.sha[:10]}")
        for cell in cells:
            log(f"  {cell.name}  ({cell.units} units, {cell.timeout_hours * self.args.timeout_factor}h)")
        if self.args.dry_run:
            self.dry_run_directory.cleanup()
            return 0
        try:
            # everything that can refuse the run, before anything of an earlier run is stopped or moved
            self.check_resume(cells)
            self.prepare_inputs(cells)
            for host in self.hosts:
                self.check_host(host)
            self.check_hosts(cells, self.checked)
            self.load_state(cells)
            self.install_inputs()
            for host in self.hosts:
                self.setup_host(host)
            self.check_hosts(cells, self.ready)
            self.started = True
            try:
                sweep([h for h in self.hosts if h.name in self.ready], self.owner, idle_hours=SWEEP_IDLE_HOURS,
                      results_dir=self.results_dir, keep={self.label})
            except HostError as e:
                log(f"sweep of idle labels failed: {e}")
            self.schedule(cells)
            self.combine_jmh_results()
            if self.aborting is not None:
                # Jenkins skips its Summary stage after a failed stage
                log("no ci_summary.html: the run stopped early (fail fast)")
            elif self.state["report"]:
                self.report()
            text, result = summarise(self.out)
            print(text)
            if not self.args.keep_stashes:
                self.clean_stashes()
            return EXIT_CODES[result]
        finally:
            self.lock.close()

    def check_resume(self, cells):
        """Refuses a run of the label with other inputs"""
        previous = self.earlier_inputs()
        if previous and previous != self.inputs and not self.args.allow_sha_change:
            what = "commit" if self.state.get("sha") != self.sha else "build.properties or --maven-mirror"
            raise SystemExit(f"label {self.label} ran {self.state.get('sha')} with other inputs; the {what} "
                             f"changed.  Use a new label, or --allow-sha-change to run every cell again")

    def earlier_inputs(self):
        """The inputs of the label's results: those a change that was not finished goes to, else the state's"""
        return (self.state.get("transition") or {}).get("inputs", self.state.get("inputs"))

    def replaces_results(self):
        """True when this run moves the label's earlier results aside, as its inputs changed"""
        previous = self.earlier_inputs()
        return bool(previous and previous != self.inputs) or "archive" in (self.state.get("transition") or {})

    def check_hosts(self, cells, usable):
        """Stops a run no host can run, or where no host has the architecture of some cells"""
        if not usable:
            why = list(self.excluded.values()) + [f"{name}: {e}" for name, (_, _, e) in self.unready.items()]
            raise SystemExit("no host can run cells: " + "; ".join(why))
        # a host not set up yet may yet answer, and run the cells of its architecture when it does
        maybe = [h for h in self.hosts if h.name not in usable and h.name not in self.excluded]
        if not any(h.arch is None for h in maybe):
            missing = sorted({c.arch for c in cells} - {h.arch for h in self.hosts if h.name not in self.excluded})
            if missing:
                raise SystemExit(f"no host for the {', '.join(missing)} cells; hosts: "
                                 f"{', '.join(f'{h} ({h.arch})' for h in self.hosts)}")

    def clean_stashes(self):
        """
        Every cell has finished: removes the label's run directory on its hosts, under the remote homes it ran with,
        and then the local stashes.  A host where the label is not this driver's holds none of them.
        """
        removed, failed = [], []
        for host in self.hosts + recorded_hosts(self.hosts, self.state, self.args.remote_home):
            if host.name in self.foreign:
                continue
            try:
                if host not in self.hosts:
                    host.remote.install(host, preflight=False)
                result = host.run(host.remote.job("rmlabel", self.label, self.owner), check=False, timeout=600)
                if result.returncode not in (0, NOT_OWNER, LABEL_DIR_UNUSABLE):
                    raise HostError(result.stderr.decode(errors="replace").strip())
                removed.append(host.name)
            except HostError as e:
                log(f"could not remove {self.label} on {host}: {e}; use `clean --label {self.label}`")
                failed.append(host.name)
        if failed:
            log(f"removed {self.label} on {', '.join(removed) or 'no host'}; the local stash is kept, as "
                f"{', '.join(failed)} still has the label")
            return
        shutil.rmtree(self.stash, ignore_errors=True)
        log(f"removed the stashes of {self.label} on {', '.join(removed)} and locally")


def attempt_host(hosts, record, remote_home):
    """The host of a stored attempt, with the remote home, runtime and scripts the attempt started with"""
    known = {h.name: h for h in hosts}.get(record["host"])
    home = record.get("home") or (known.remote.given_home if known else remote_home)
    version = record.get("version")
    if known is not None and known.remote.given_home == home and (version is None or known.remote.version == version):
        return known
    host = Host(record["host"], runtime=record.get("runtime", known.runtime if known else None))
    host.remote = Remote(home, version)
    return host


def recorded_hosts(hosts, state, remote_home):
    """The hosts a label ran on under a remote home the hosts file does not give them, with their runtime"""
    have = {(h.name, h.remote.given_home) for h in hosts}
    extra = {}
    for record in list(state.get("hosts", {}).values()) + list(state.get("cells", {}).values()):
        if record.get("host"):
            key = (record["host"], record.get("home") or remote_home)
            if key not in have and key not in extra:
                extra[key] = Host(key[0], runtime=record.get("runtime"))
                extra[key].remote = Remote(key[1])
    return [extra[key] for key in sorted(extra)]


def unconfirmed_stop(host, attempt_id):
    """An attempt that may still run on its host, until the host confirms it has stopped"""
    return {"host": host, "attempt_id": attempt_id, "since": time.time(), "retry_at": 0, "delay": 0}


def restore_last_done(entry):
    """Makes a cell's entry that of its last downloaded result, or of a cell that has not run"""
    for key in [k for k in entry if k not in ("name", "kind", "done_attempts", "last_done")]:
        del entry[key]
    entry.update(entry.get("last_done") or {"status": "not run", "rc": None})


def attempt_record(host, attempt, attempt_id):
    """Where an attempt runs: its host, and the remote home, runtime and scripts it started with"""
    return {"attempt": attempt, "attempt_id": attempt_id, "host": host.name, "home": host.remote.given_home,
            "runtime": host.runtime, "version": host.remote.version}


def recorded_attempt(out, cell_id, entry):
    """The directory of the attempt a cell's entry records as done, or None: a cell not done adds nothing"""
    if not entry or entry.get("status") != "done" or not entry.get("attempt"):
        return None
    path = Path(out) / "cells" / cell_id / f"attempt{entry['attempt']}"
    return path if path.is_dir() else None


def cell_succeeded(entry, kind):
    """
    A cell succeeded when it finished, its script exited 0, a test cell left test results, and the report cell
    made the report
    """
    return (entry.get("status") == "done" and entry.get("rc") == 0
            and (kind != "test" or entry.get("junit", 0) > 0) and (kind != "report" or entry.get("artifacts", False)))


def report_made(out):
    return all((out / name).is_file() and (out / name).stat().st_size > 0 for name in REPORT_ARTIFACTS)


