def _normalise_groovy(text):
    return " ".join(re.sub(r"//[^\n]*", "", text).split())


def _normalise_code(text):
    """Groovy code without its comments, and without the whitespace outside string literals but for one space"""
    out, i, n, space = [], 0, len(text), False
    while i < n:
        if text.startswith("//", i) or text.startswith("/*", i):
            end = text.find("\n" if text[i + 1] == "/" else "*/", i + 2)
            i = n if end < 0 else end + (0 if text[i + 1] == "/" else 2)
            space = True
            continue
        quote = next((q for q in ("'''", '"""', "'", '"') if text.startswith(q, i)), None)
        if quote is None and text[i].isspace():
            space, i = True, i + 1
            continue
        if space and out:
            out.append(" ")
        space = False
        if quote is None:
            out.append(text[i])
            i += 1
            continue
        end = i + len(quote)
        while end < n and not text.startswith(quote, end):
            end += 2 if text[end] == "\\" else 1
        out.append(text[i:end + len(quote)])
        i = end + len(quote)
    return "".join(out)


# literals the tool parses, not reproduces: a function's digest leaves them out, so that new splits are no drift
PARSED_LITERALS = (r"\bdef\s+buildSteps\s*=\s*", r"\bdef\s+testSteps\s*=\s*")


def function_digest(text, name):
    body = groovy_function(text, name)
    for anchor in PARSED_LITERALS:
        match = re.search(anchor, body)
        if match:
            tokens = _GroovyTokens(body, match.end())
            _groovy_value(tokens)
            body = body[:match.end()] + "[]" + body[tokens.pos:]
    return hashlib.sha1(_normalise_code(body).encode()).hexdigest()[:16]


def groovy_function(text, name):
    """The source of a top level function of the Jenkinsfile, up to the next top level definition, or ''"""
    match = re.search(rf"^def\s+(?:\w+\s+)?{re.escape(name)}\s*\(", text, re.M)
    if not match:
        return ""
    end = re.compile(r"^(?:def\s|@|/{6,})", re.M).search(text, match.end())
    return text[match.start():end.start() if end else len(text)]


def groovy_block(text, name):
    """The body of the first `<name> {` block of the Jenkinsfile, braces matched, or ''"""
    match = re.search(rf"^\s*{re.escape(name)}\s*\{{", text, re.M)
    if not match:
        return ""
    depth, pos = 1, match.end()
    while depth and pos < len(text):
        depth += {"{": 1, "}": -1}.get(text[pos], 0)
        pos += 1
    return text[match.end():pos - 1]


def jenkinsfile_drift(text):
    """
    What run-ci-local reproduces that the given Jenkinsfile has changed: (function, None) for a function whose
    digest differs, and (function, code) for a line of JENKINSFILE_MIRRORED it no longer has
    """
    changed = [(function, None) for function, digest in JENKINSFILE_DIGESTS.items()
               if function_digest(text, function) != digest]
    return changed + [(function, snippet) for function, snippet in JENKINSFILE_MIRRORED
                      if _normalise_groovy(snippet) not in _normalise_groovy(groovy_function(text, function))]


def python_regex(pattern, what):
    """The pattern for Python's re, with Java's named groups (?<name>...) as (?P<name>...)"""
    translated = re.sub(r"\(\?<(?=[A-Za-z_])", "(?P<", pattern)
    try:
        re.compile(translated)
    except re.error as e:
        raise SystemExit(f"{what} {pattern!r}: {e}.  It is a Python regex (the re module), where Java's "
                         f"(?<name>...) groups also work") from e
    return translated


def build_xml_property(build_xml, name):
    match = re.search(rf'property\s*name="{re.escape(name)}"\s*value="([^"]*)"', build_xml)
    if not match:
        raise JenkinsfileError(f"{name} not found in build.xml")
    return match.group(1)


