class HostError(Exception):
    pass


class PreflightError(HostError):
    """A host that answers but cannot run cells"""


class ClaimError(HostError):
    """A host where the label is another driver's, or a directory run-ci-local did not make"""


class PrestartError(HostError):
    """A host that failed before a cell's start went out"""


class Host:
    def __init__(self, name, capacity=None, runtime=None, arch=None, home=None):
        if not name or name.startswith("-"):
            raise ValueError(f"invalid host name {name!r}")
        self.name = name
        self.capacity = capacity
        self.runtime = runtime
        self.arch = arch
        self.home = home
        self.local = name == "localhost"
        self.remote = None

    def command(self, remote_command):
        # bash runs the command whatever the login shell on the host is
        if self.local:
            return ["bash", "-c", remote_command]
        control = ssh_control_directory() / "%C"
        return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20", "-o", "ServerAliveInterval=30",
                "-o", "ControlMaster=auto",
                "-o", f"ControlPath={control}", "-o", "ControlPersist=10m", "--", self.name,
                "exec bash -c " + shlex.quote(remote_command)]

    def run(self, remote_command, check=True, input_bytes=None, timeout=SSH_TIMEOUT, stdout=subprocess.PIPE,
            stdin=None):
        """Runs a command on the host.  Raises HostError when check and it fails, and on a timeout."""
        if self.runtime:
            remote_command = f"export CI_LOCAL_RUNTIME={self.runtime}; {remote_command}"
        try:
            result = subprocess.run(self.command(remote_command), input=input_bytes, stdin=stdin, stdout=stdout,
                                    stderr=subprocess.PIPE, timeout=timeout, check=False)
        except subprocess.TimeoutExpired as e:
            raise HostError(f"{self.name}: `{remote_command}` timed out after {timeout}s") from e
        if check and result.returncode != 0:
            raise HostError(f"{self.name}: `{remote_command}` failed with {result.returncode}: "
                            f"{result.stderr.decode(errors='replace')[-2000:]}")
        return result

    def __repr__(self):
        return self.name


def ssh_control_directory():
    """
    A directory of this user's alone for the ssh control sockets, in /tmp whatever TMPDIR is: a socket path has
    to fit in 104 bytes on macOS
    """
    directory = Path("/tmp") / f"run-ci-local-{os.getuid()}"
    directory.mkdir(mode=0o700, exist_ok=True)
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise SystemExit(f"{directory} must be a directory of this user's with mode 0700")
    return directory


def load_hosts(path, remote_home):
    """
    Lines of `<host> [<capacity>] [runtime=docker|podman] [arch=amd64|arm64] [home=<directory>]`, # starts a
    comment.  home overrides remote_home for the host.
    """
    hosts = []
    for number, line in enumerate(Path(path).expanduser().read_text().splitlines(), 1):
        fields = line.split("#", 1)[0].split()
        if not fields:
            continue
        try:
            host = Host(fields[0])
        except ValueError as e:
            raise ValueError(f"{path}:{number}: {e}") from e
        for field in fields[1:]:
            if field.isdigit():
                host.capacity = int(field)
            elif field in ("runtime=docker", "runtime=podman"):
                host.runtime = field.split("=", 1)[1]
            elif re.fullmatch(r"arch=\w+", field):
                host.arch = field.split("=", 1)[1]
            elif field.startswith("home=") and len(field) > len("home="):
                host.home = field.split("=", 1)[1]
            else:
                raise ValueError(f"{path}:{number}: unknown field {field!r}")
        host.remote = Remote(host.home or remote_home)
        hosts.append(host)
    if not hosts:
        raise ValueError(f"{path} lists no hosts")
    return hosts


def remote_version():
    """A digest of the remote scripts: each version installs into its own bin/<version>/"""
    digest = hashlib.sha1()
    for path in sorted(p for p in REMOTE_DIR.rglob("*") if p.is_file()):
        digest.update(str(path.relative_to(REMOTE_DIR)).encode() + b"\0" + path.read_bytes())
    return digest.hexdigest()[:12]


def check_name(name, what="label"):
    if not re.fullmatch(NAME_PATTERN, name or ""):
        raise SystemExit(f"{what} {name!r}: use letters, digits, '.', '_' and '-', not starting with '.' or '-'")
    return name


class Remote:
    """
    The paths and job.sh calls on the hosts.  home is relative to the remote $HOME, or absolute; it is quoted
    once, and every name appended to it is a checked single path component.
    """

    def __init__(self, home, version=None):
        if re.search(r"\s", home):
            raise SystemExit(f"remote home {home!r}: a directory without whitespace, which the .build/docker scripts "
                             f"do not quote")
        self.given_home = home
        self.home = shlex.quote(home) if home.startswith("/") else '"$HOME"/' + shlex.quote(home)
        # the scripts an attempt started with, which a later driver keeps using for that attempt
        self.version = version or remote_version()

    def path(self, *names):
        for name in names:
            check_name(name, "path component")
        return "/".join((self.home,) + names)

    def job(self, *args):
        return self.path("bin", self.version, "job.sh") + " " + " ".join(shlex.quote(str(a)) for a in args)

    def run_dir(self, label, *names):
        return self.path("runs", label, *names)

    def install(self, host, preflight=True):
        """Installs job.sh and the podman wrapper, sets the capacity, and checks the host can run cells"""
        buffer = io.BytesIO()
        with tarfile.open(fileobj=buffer, mode="w") as tar:
            tar.add(str(REMOTE_DIR), arcname=".")
        # extracted aside and renamed into place: drivers can install at once, and running cells keep their copy
        version_dir = self.path("bin", self.version)
        host.run(f'test -x {version_dir}/job.sh || {{ mkdir -p {self.home}/bin && '
                 f'd=$(mktemp -d {self.home}/bin/.install.XXXXXX) && tar -C "$d" -xf - && '
                 f'chmod +x "$d/job.sh" "$d/podman/docker" && '
                 f'{{ mv -T "$d" {version_dir} 2>/dev/null || rm -rf "$d"; }}; }}',
                 input_bytes=buffer.getvalue())
        host.run(self.job("init", host.capacity or ""))
        if not preflight:
            return
        result = host.run(self.job("preflight"), check=False)
        if result.returncode == 1 and result.stdout.strip():
            raise PreflightError(f"{host} cannot run cells: {result.stdout.decode(errors='replace').strip()}")
        if result.returncode == 3:
            raise HostError(f"{host} cannot run cells for now: {result.stdout.decode(errors='replace').strip()}")
        if result.returncode != 0:
            raise HostError(f"{host}: preflight failed with {result.returncode}: "
                            f"{result.stderr.decode(errors='replace').strip()}")


