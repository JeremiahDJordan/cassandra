class Cell:
    """One parallel task of the Jenkinsfile's tasks(): a step, on one jdk, python, cython and split."""

    def __init__(self, step, command, units, jdk, python, cython, split=1, test_regexp="", arch="amd64"):
        self.step, self.command, self.units = step, command, units
        self.jdk, self.python, self.cython, self.split = jdk, python, cython, split
        self.arch = arch
        self.test_regexp = test_regexp
        self.kind = "jar" if step == "jar" else command["type"]
        self.splits = command["splits"]
        self.timeout_hours = command["timeout_hours"]

    @property
    def name(self):
        """getStepName() of the Jenkinsfile"""
        arch = "" if self.arch == "amd64" else f" {self.arch}"
        python = f" python{self.python}" if self.step == "cqlsh-test" else ""
        cython = " cython" if self.cython != "no" else ""
        split = f" {self.split}/{self.splits}" if self.splits > 1 and not self.test_regexp else ""
        test = f" -t {self.test_regexp}" if self.test_regexp else ""
        return f"{self.step}{arch} jdk{self.jdk}{python}{cython}{split}{test}"

    @property
    def suffix(self):
        """cell_suffix of the Jenkinsfile's build() and test()"""
        if self.kind == "test":
            return f"_jdk{self.jdk}_python_{self.python}_{self.cython}_{self.arch}_{self.split}_{self.splits}"
        return f"_jdk{self.jdk}_{self.arch}"

    @property
    def cell_id(self):
        test = "_t" + hashlib.sha1(self.test_regexp.encode()).hexdigest()[:8] if self.test_regexp else ""
        return re.sub(r"[^\w.-]", "_", f"{self.step}{self.suffix}{test}")

    @property
    def base(self):
        """The stash of the jar stage the cell starts from, the Jenkinsfile's stash <arch>_<jdk>"""
        return f"base-{self.arch}-jdk{self.jdk}.tar"

    def env(self, timeout_factor, runtime, extra=None):
        values = dict(KIND=self.kind, STEP=self.step, SCRIPT=self.command.get("script", ""), JDK=self.jdk,
                      ARCH=self.arch, SPLIT=self.split, SPLITS=self.splits, PYTHON=self.python, CYTHON=self.cython,
                      TEST_REGEXP=self.test_regexp, TIMEOUT_HOURS=self.timeout_hours * timeout_factor,
                      PYTHON_DTEST="yes" if self.command.get("python-dtest") else "no", CELL_SUFFIX=self.suffix,
                      RUNTIME=runtime or "", BASE=self.base)
        values.update(extra or {})
        return "".join(f"{k}={shlex.quote(str(v))}\n" for k, v in values.items())


class ReportCell(Cell):
    def __init__(self):
        super().__init__("report", {"type": "report", "splits": 1, "timeout_hours": REPORT_TIMEOUT_HOURS},
                         REPORT_UNITS, "", "", "no")

    @property
    def name(self):
        return "report"

    @property
    def cell_id(self):
        return "report"


def plan_cells(pipeline, java_default, java_supported, profile, profile_custom_regexp="", jdk="", test_regexp="",
               architecture="amd64"):
    """
    The cells tasks() of the Jenkinsfile creates for these parameters, jar cells first.  With test_regexp every
    test step runs once per jdk, with run-tests.sh -t, in place of its splits.
    """
    profiles, steps = pipeline["profiles"], pipeline["steps"]
    if profile not in profiles:
        raise ValueError(f"no profile {profile!r} in .jenkins/Jenkinsfile; profiles: {', '.join(profiles)}")
    if profile == "custom" and not profile_custom_regexp:
        raise ValueError("the custom profile needs a regexp of steps")
    archs = [a for a in pipeline["archs"] if architecture in (a, "all")]
    if not archs:
        raise ValueError(f"architecture {architecture!r} is not one of {', '.join(pipeline['archs'] + ['all'])}")
    jdk = (jdk or "").strip()
    if jdk and jdk not in java_supported:
        raise ValueError(f"jdk {jdk} is not in build.xml's java.supported {','.join(java_supported)}")
    java_python_dtests = jdk or java_default

    def stage_enabled(step):
        return ("jar" == step or step in profiles[profile]
                or (profile == "custom" and re.fullmatch(profile_custom_regexp, step) is not None))

    cells = []
    for arch in archs:
        for java in java_supported:
            if jdk and jdk != java:
                continue
            for python in pipeline["pythons"]:
                for cython in ("yes", "no"):
                    for step, command in steps.items():
                        if not stage_enabled(step):
                            continue
                        if python != pipeline["python_default"] and step != "cqlsh-test":
                            continue
                        if cython != "no" and step != "cqlsh-test":
                            continue
                        if cython == "yes" and python in ("3.12", "3.13"):
                            continue
                        if java != java_default and (step in ("cqlsh-test", "simulator-dtest")
                                                     or "dtest-upgrade" in step):
                            continue
                        if java != java_python_dtests and command.get("python-dtest"):
                            continue
                        if arch != "amd64" and command["type"] != "build":
                            continue
                        units = pipeline["sizes"][command["size"]]
                        if test_regexp and command["type"] == "test":
                            cells.append(Cell(step, command, units, java, python, cython, test_regexp=test_regexp,
                                              arch=arch))
                            continue
                        for split in range(1, command["splits"] + 1):
                            cells.append(Cell(step, command, units, java, python, cython, split, arch=arch))
    cells.sort(key=lambda c: c.kind != "jar")
    return cells


