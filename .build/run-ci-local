class JenkinsfileError(Exception):
    pass


_GROOVY_TOKEN = re.compile(r"""
    (?P<space>\s+|//[^\n]*|/\*.*?\*/)
  | (?P<string>'(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*")
  | (?P<number>-?\d+)
  | (?P<word>[A-Za-z_]\w*)
  | (?P<punct>[\[\]:,])
""", re.S | re.X)


class _GroovyTokens:
    def __init__(self, text, pos):
        self.text = text
        self.pos = pos
        self.pushed = []

    def where(self):
        return f"line {self.text.count(chr(10), 0, self.pos) + 1}"

    def next(self):
        if self.pushed:
            return self.pushed.pop()
        while True:
            match = _GROOVY_TOKEN.match(self.text, self.pos)
            if not match:
                raise JenkinsfileError(f"not a Groovy literal at {self.where()}: {self.text[self.pos:self.pos + 40]!r}")
            self.pos = match.end()
            if match.lastgroup != "space":
                return match.lastgroup, match.group()

    def push(self, token):
        self.pushed.append(token)


def _groovy_scalar(tokens, token):
    kind, text = token
    if kind == "string":
        if text[0] == '"' and "$" in text:
            raise JenkinsfileError(f"GString {text} at {tokens.where()} is not a literal")
        return re.sub(r"\\(.)", r"\1", text[1:-1])
    if kind == "number":
        return int(text)
    if kind == "word" and text in ("true", "false", "null"):
        return {"true": True, "false": False, "null": None}[text]
    raise JenkinsfileError(f"{text!r} at {tokens.where()} is not a literal")


def _groovy_value(tokens):
    token = tokens.next()
    if token != ("punct", "["):
        return _groovy_scalar(tokens, token)
    first = tokens.next()
    if first == ("punct", "]"):
        return []
    if first == ("punct", ":"):
        if tokens.next() != ("punct", "]"):
            raise JenkinsfileError(f"expected ] at {tokens.where()}")
        return {}
    second = tokens.next()
    if second == ("punct", ":"):
        result = {}
        key_token = first
        while True:
            if key_token[0] not in ("string", "number", "word"):
                raise JenkinsfileError(f"bad map key {key_token[1]!r} at {tokens.where()}")
            key = key_token[1] if key_token[0] == "word" else _groovy_scalar(tokens, key_token)
            result[key] = _groovy_value(tokens)
            separator = tokens.next()
            if separator == ("punct", "]"):
                return result
            if separator != ("punct", ","):
                raise JenkinsfileError(f"expected , or ] at {tokens.where()}")
            key_token = tokens.next()
            if key_token == ("punct", "]"):
                return result
            if tokens.next() != ("punct", ":"):
                raise JenkinsfileError(f"expected : at {tokens.where()}")
    tokens.push(second)
    tokens.push(first)
    result = []
    while True:
        result.append(_groovy_value(tokens))
        separator = tokens.next()
        if separator == ("punct", "]"):
            return result
        if separator != ("punct", ","):
            raise JenkinsfileError(f"expected , or ] at {tokens.where()}")
        following = tokens.next()
        if following == ("punct", "]"):
            return result
        tokens.push(following)


def parse_groovy_literal(text, pos=0):
    """The Groovy list, map, string, integer or boolean literal at text[pos:], as Python values."""
    return _groovy_value(_GroovyTokens(text, pos))


def _jenkinsfile_literal(text, anchor, what):
    match = re.search(anchor, text)
    if not match:
        raise JenkinsfileError(f"{what} not found in .jenkins/Jenkinsfile")
    return parse_groovy_literal(text, match.end())


def read_pipeline(text):
    """
    The profiles, steps and axes of a .jenkins/Jenkinsfile.  The literals are parsed, the defaults that tasks()
    adds are applied here; JENKINSFILE_MIRRORED lists the Jenkinsfile code this relies on.
    """
    profiles = _jenkinsfile_literal(text, r"\bdef\s+pipelineProfiles\s*\(\s*\)\s*\{\s*return\s+", "pipelineProfiles()")
    build_steps = _jenkinsfile_literal(text, r"\bdef\s+buildSteps\s*=\s*", "buildSteps")
    test_steps = _jenkinsfile_literal(text, r"\bdef\s+testSteps\s*=\s*", "testSteps")
    pythons = _jenkinsfile_literal(text, r"@Field\s+List<String>\s+pythonsSupported\s*=\s*", "pythonsSupported")
    archs = _jenkinsfile_literal(text, r"@Field\s+List<String>\s+archsSupported\s*=\s*", "archsSupported")
    python_default = _jenkinsfile_literal(text, r"@Field\s+String\s+pythonDefault\s*=\s*", "pythonDefault")
    # the agent sizes, from the header: "//  - cassandra-small + cassandra-${arch}-small  : 1 cpu, 1GB ram"
    sizes = {m.group(1): int(m.group(2))
             for m in re.finditer(r"^//\s*-\s*cassandra-(\w+)\s*\+[^:\n]*:\s*(\d+)\s*cpu", text, re.M)}
    if not (isinstance(profiles, dict) and all(isinstance(v, list) for v in profiles.values())):
        raise JenkinsfileError("pipelineProfiles() is not a map of lists")
    for steps in (build_steps, test_steps):
        if not (isinstance(steps, dict) and all(isinstance(v, dict) for v in steps.values())):
            raise JenkinsfileError("buildSteps and testSteps must be maps of maps")
    steps = {}
    for name, command in build_steps.items():
        steps[name] = dict(command, type="build", splits=1, timeout_hours=1)
        steps[name].setdefault("size", "small")
    for name, command in test_steps.items():
        steps[name] = dict(command, type="test")
        steps[name].setdefault("size", "medium")
        steps[name]["timeout_hours"] = command.get("timeout_hours") or 1
        if name.startswith("dtest"):
            steps[name]["python-dtest"] = True
    missing = {c["size"] for c in steps.values()} - set(sizes)
    if missing:
        raise JenkinsfileError(f"agent sizes {sorted(missing)} have no cpu count in the .jenkins/Jenkinsfile header")
    return {"profiles": profiles, "steps": steps, "pythons": pythons, "python_default": python_default,
            "sizes": sizes, "archs": archs, "defaults": jenkins_parameter_defaults(text, archs)}


def jenkins_parameter_defaults(text, archs):
    """
    The defaults of the job's parameters in the Jenkinsfile's parameters block, but for repository and branch,
    which default to the job's own scm there, and to the local checkout here.
    """
    names = re.findall(r"^\s*(?:string|choice)\(name:\s*'(\w+)'", groovy_block(text, "parameters"), re.M)
    if sorted(names) != sorted(JENKINS_PARAMETERS):
        raise JenkinsfileError(f"the Jenkinsfile's parameters are {names}, "
                               f"run-ci-local knows {list(JENKINS_PARAMETERS)}")
    defaults = {"repository": "", "branch": "", "architecture": archs[0]}
    for name in ("profile_custom_regexp", "jdk", "dtest_repository", "dtest_branch"):
        match = re.search(rf"string\(name:\s*'{name}',\s*defaultValue:\s*params\.{name}\s*\?:\s*'([^']*)'", text)
        if not match:
            raise JenkinsfileError(f"no default for the {name} parameter in the Jenkinsfile")
        defaults[name] = match.group(1)
    match = re.search(r"names\.contains\(putFirst\)\s*\?\s*putFirst\s*:\s*'([^']+)'", text)
    if not match:
        raise JenkinsfileError("no default profile in pipelineProfileNames() of the Jenkinsfile")
    defaults["profile"] = match.group(1)
    return defaults


