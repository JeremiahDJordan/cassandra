def sweep(hosts, owner, labels=None, idle_hours=None, results_dir=None, force=False, dry_run=False, keep=(), held=(),
          unreachable=False):
    """
    Removes the run directories of this driver's labels on the hosts, and their local stashes: the given labels,
    or else the labels idle for idle_hours.  Never a label whose driver runs on this machine or whose cell runs on
    a host, nor, without force, a label another driver owns.  A given label is removed from no host at all while
    a host cannot be asked, or one of its cells runs on any host; a local stash goes only once every host has
    removed its label.
    """
    now = time.time()
    locks = {}
    listings, unreachable = list_labels(hosts, unreachable)
    try:
        if labels is None and results_dir:
            # an idle label is removed under its lock, so that no driver here takes it meanwhile, and its idleness
            # is checked again once the lock is held
            idle = {label for _, entries in listings for label, live, newest, _, label_owner in entries
                    if label_owner == owner and not live and now - newest >= idle_hours * 3600 and label not in keep}
            for label in sorted(idle):
                lock = lock_label(Path(results_dir) / label)
                if lock is not None:
                    locks[label] = lock
            if not locks:
                return
            listings, unreachable = list_labels(hosts, unreachable)
            listings = [(host, [e for e in entries if e[0] in locks]) for host, entries in listings]
            held = set(held) | set(locks)
        sweep_listed(listings, owner, labels, idle_hours, results_dir, force, dry_run, keep, held, unreachable, now)
    finally:
        for lock in locks.values():
            lock.close()


def list_labels(hosts, unreachable):
    """[(host, [(label, running cells, newest mtime, stash bytes, owner)])], and whether a host did not answer"""
    listings = []
    for host in hosts:
        try:
            listing = host.run(host.remote.job("labels"), timeout=300).stdout.decode().splitlines()
        except HostError as e:
            log(f"clean: {host}: {e}")
            unreachable = True
            continue
        entries = []
        for line in listing:
            fields = line.split()
            if len(fields) == 5:
                entries.append((fields[0], int(fields[1]), int(fields[2] or 0), int(fields[3]), fields[4]))
        listings.append((host, entries))
    return listings, unreachable


def sweep_listed(listings, owner, labels, idle_hours, results_dir, force, dry_run, keep, held, unreachable, now):
    removed, kept = set(), set()
    if labels is not None:
        # all or nothing, across the hosts where the label is this driver's
        if unreachable:
            log(f"clean: a host could not be asked; nothing of {', '.join(sorted(labels))} is removed, on any host")
            kept.update(labels)
        for host, entries in listings:
            for label, live, _, _, label_owner in entries:
                if label in labels and live and (label_owner == owner or force):
                    log(f"clean: {host}: {label} still runs a cell; nothing of it is removed, on any host")
                    kept.add(label)
    for host, entries in listings:
        listed = {entry[0] for entry in entries}
        for label in sorted(set(labels or ()) - listed - kept):
            # what an interrupted claim left
            if not dry_run:
                result = host.run(host.remote.job("rmlabel", label, owner), check=False, timeout=600)
                if result.returncode not in (0, NOT_OWNER, LABEL_DIR_UNUSABLE):
                    log(f"clean: {host}: {label}: {result.stderr.decode(errors='replace').strip()}")
                    kept.add(label)
        for label, live, newest, size, label_owner in entries:
            if label in keep or (labels is not None and (label not in labels or label in kept)):
                continue
            if label_owner != owner and not (force and labels is not None):
                if labels is not None:
                    # it holds nothing of this driver's
                    log(f"clean: {host}: {label} belongs to another driver; left alone (--force removes it)")
                continue
            if live or (label not in held and results_dir and label_active(Path(results_dir) / label)):
                if labels is not None:
                    log(f"clean: {host}: {label} is still running; kept")
                    kept.add(label)
                continue
            if labels is None and now - newest < idle_hours * 3600:
                continue
            log(f"clean: {host}: {'would remove' if dry_run else 'removing'} {label} ({size / 1e9:.1f} GB of stashes)")
            removed.add(label)
            if not dry_run:
                result = host.run(host.remote.job("rmlabel", label, owner, *(["force"] if force else [])),
                                  check=False, timeout=600)
                if result.returncode != 0:
                    log(f"clean: {host}: {label} not removed: {result.stderr.decode(errors='replace').strip()}")
                    kept.add(label)
    for label in sorted((labels if labels is not None else removed) - kept):
        out = Path(results_dir) / label if results_dir else None
        # the stash of a label this tool made here only
        if (out and (out / "stash").is_dir() and (out / LABEL_MARKER).is_file()
                and (label in held or not label_active(out))):
            log(f"clean: {'would remove' if dry_run else 'removing'} {out / 'stash'}")
            if not dry_run:
                shutil.rmtree(out / "stash", ignore_errors=True)
    for label in sorted(kept & (labels or set())):
        log(f"clean: the local stash of {label} is kept, as a host still has the label")


def status(args):
    hosts = load_hosts(args.hosts, args.remote_home)
    for host in hosts:
        try:
            host.remote.install(host, preflight=False)
            free = host.run(host.remote.job("capacity"), timeout=60).stdout.decode().split()
            runtime = host.run(host.remote.job("runtime"), timeout=60).stdout.decode().strip()
            arch = host.arch or host.run(host.remote.job("arch"), timeout=60).stdout.decode().strip()
            print(f"{host}: {free[0]} of {free[1]} units free, {arch}, {runtime}")
        except (HostError, IndexError) as e:
            print(f"{host}: {e}")
    if args.label:
        state = json.loads((Path(args.results_dir).expanduser() / check_name(args.label) / "state.json").read_text())
        counts = {}
        for entry in state["cells"].values():
            counts[entry.get("status")] = counts.get(entry.get("status"), 0) + 1
        print(f"{args.label}: {counts}")
        for cell_id, entry in sorted(state["cells"].items(), key=lambda item: item[1].get("name")):
            if entry.get("status") == "running" and entry.get("host") and entry.get("attempt_id"):
                # asked where the attempt started, also when its host has left the hosts file
                host = attempt_host(hosts, entry, args.remote_home)
                try:
                    now = host.run(host.remote.job("status", args.label, cell_id, entry["attempt_id"]), check=False,
                                   timeout=60).stdout.decode().strip()
                except HostError as e:
                    now = str(e)
                print(f"  running: {entry.get('name')} on {host}: {now}")


def argument_parser():
    parser = argparse.ArgumentParser(description="Run the Jenkins CI pipeline on hosts reached over ssh, without "
                                                 "Jenkins.",
                                     epilog="Exit codes: 0 SUCCESS, 1 the run could not start or go on (hosts, "
                                            "checkout, label), 2 usage, 3 UNSTABLE (failing tests), 4 FAILURE (a "
                                            "failed, lost or result-less cell).  See .build/run-ci-local.d/README.md")
    parser.add_argument("--config", help="Config file, see .build/run-ci-local.d/run-ci-local.conf.example (default: "
                                         "$RUN_CI_LOCAL_CONFIG, else $XDG_CONFIG_HOME/cassandra/run-ci-local.conf or "
                                         "~/.config/cassandra/run-ci-local.conf).")
    parser.add_argument("--hosts", help="Hosts file, see .build/run-ci-local.d/hosts.example (default: "
                                        "$RUN_CI_LOCAL_HOSTS, "
                                        "else $XDG_CONFIG_HOME/cassandra/run-ci-local-hosts or "
                                        "~/.config/cassandra/run-ci-local-hosts).")
    parser.add_argument("--remote-home", help=f"Directory on the hosts for scripts, slots and runs, relative to the "
                                              f"remote home (default: {DEFAULT_REMOTE_HOME}).")
    parser.add_argument("--results-dir", help="Results go to <results-dir>/<label>/ (default: build/ci-local).")
    commands = parser.add_subparsers(dest="command", required=True)

    run = commands.add_parser("run", help="Run a pipeline profile, or part of one.  Rerunning a label resumes it.")
    run.add_argument("-l", "--label", required=True, help="Name of the run, and of its results directory.")
    run.add_argument("--src", default=str(CASSANDRA_DIR), help="The git checkout to test (default: this one).")
    run.add_argument("-r", "--repository", help="Repository URL to fetch and test, as Jenkins does.  Defaults to "
                                                "testing the checkout; with only --branch, its upstream repository.")
    run.add_argument("-b", "--branch", help="Branch of the repository to fetch and test.  Defaults to testing the "
                                            "checkout; with only --repository, its branch.")
    run.add_argument("-p", "--profile", help="CI pipeline profile.  Defaults to the Jenkinsfile's, skinny.")
    run.add_argument("-e", "--profile-custom-regexp",
                     help="Regexp of steps for the custom profile.  Example: 'stress.*|jvm-dtest'")
    run.add_argument("--architecture", help="amd64, arm64 or all, as the Jenkins parameter.  Defaults to amd64.")
    run.add_argument("-j", "--jdk", help="Specify JDK version. Defaults to all JDKs the checkout supports.")
    run.add_argument("-d", "--dtest-repository", help="DTest repository URL.")
    run.add_argument("-k", "--dtest-branch", help="DTest repository branch.")
    run.add_argument("--dtest-dir", help="A local cassandra-dtest checkout to use, in place of a clone.")
    run.add_argument("--fail-fast", dest="fail_fast", action="store_const", const=True,
                     help="Stop the run when a cell fails its last attempt, as Jenkins does (the default).")
    run.add_argument("--no-fail-fast", dest="fail_fast", action="store_const", const=False,
                     help="Run every cell whatever fails, and make the report.")
    run.add_argument("--cells", default="",
                     help="Regexp (search) of the cell names to run, e.g. 'test jdk11 (3|5)/20'.")
    run.add_argument("-t", "--test", default="",
                     help="Run each test step once, with run-tests.sh -t <regexp>, in place of its splits.")
    run.add_argument("--maven-mirror", help="Maven repository URL every cell resolves dependencies from, in place of "
                                            "Maven Central.")
    run.add_argument("--timeout-factor", type=int, help="Multiplier of the Jenkinsfile's timeouts (default: 1).")
    run.add_argument("--report", dest="report", action="store_const", const=True,
                     help="Make ci_summary.html and results_details.tar.xz (the default).")
    run.add_argument("--no-report", dest="report", action="store_const", const=False,
                     help="Skip ci_summary.html and results_details.tar.xz.")
    run.add_argument("--force", action="store_true",
                     help="Rerun the cells that already finished, and let the options given change the label's "
                          "parameters.")
    run.add_argument("--allow-sha-change", action="store_true",
                     help="Run a label again after new commits or another build.properties: every cell runs again.")
    run.add_argument("--forget-host", action="append", default=[], metavar="HOST",
                     help="As a label resumes, do not wait for this host to stop the label's earlier cells; it stops "
                          "them before it runs one.  Repeatable.")
    run.add_argument("--keep-stashes", action="store_true",
                     help="Keep the source and build tarballs after the run, for a --force rerun.  Remove them "
                          "with clean.")
    run.add_argument("-n", "--dry-run", action="store_true", help="Print the parameters and cells and exit.")

    summary = commands.add_parser("summary", help="Print a label's summary again.")
    summary.add_argument("-l", "--label", required=True)

    clean = commands.add_parser("clean", help="Remove the stashes of finished labels on the hosts and locally.")
    clean.add_argument("-l", "--label", action="append", default=[], help="A label to clean, repeatable.")
    clean.add_argument("--stop", action="store_true", help="Stop the label's running cells first.")
    clean.add_argument("--force", action="store_true", help="Also remove a label another driver owns.")
    clean.add_argument("--idle-hours", type=float,
                       help="Without --label, clean every label of this driver idle this long.")
    clean.add_argument("-n", "--dry-run", action="store_true")

    commands.add_parser("set-capacity", help="Set the capacity of the hosts the hosts file gives one, replacing what "
                                              "they have.  Otherwise a host keeps its capacity.")

    host_status = commands.add_parser("status", help="Free capacity, architecture and container runtime of each host.")
    host_status.add_argument("-l", "--label", default="", help="Also list the label's running cells.")
    return parser


def main(argv=None):
    args = argument_parser().parse_args(argv)
    config_file = args.config or default_config_file()
    config = load_config(config_file, required=bool(args.config or os.environ.get("RUN_CI_LOCAL_CONFIG")))
    apply_settings(args, config)
    try:
        if args.command == "run":
            return Run(args, config).execute()
        if args.command == "summary":
            text, result = summarise(Path(args.results_dir).expanduser().resolve() / check_name(args.label))
            print(text)
            return EXIT_CODES[result]
        if args.command == "clean":
            if not args.label and args.idle_hours is None:
                raise SystemExit("clean: pass --label <label> or --idle-hours <hours>")
            for label in args.label:
                check_name(label)
            results_dir = Path(args.results_dir).expanduser().resolve()
            hosts, owner = load_hosts(args.hosts, args.remote_home), owner_id(results_dir)
            # The locks of the labels, held from before anything is asked of a host to the end of the clean, as a
            # run holds them
            locks, running = {}, set()
            for label in args.label:
                lock = lock_label(results_dir / label)
                if lock is None:
                    log(f"clean: {label} is running on this machine; kept")
                    running.add(label)
                else:
                    locks[label] = lock
            labels = set(args.label) - running
            if args.label and not labels:
                return 0
            # and the hosts, under the remote homes, where the labels' attempts ran
            for label in sorted(locks):
                if (results_dir / label / "state.json").is_file():
                    state = json.loads((results_dir / label / "state.json").read_text())
                    hosts += recorded_hosts(hosts, state, args.remote_home)
            reachable = []
            for host in hosts:
                try:
                    host.remote.install(host, preflight=False)
                    reachable.append(host)
                except HostError as e:
                    log(f"clean: {host} could not be reached, and keeps its labels: {e}")
            unstopped = set()
            if args.stop and not args.dry_run:
                for host in reachable:
                    for label in sorted(labels):
                        result = host.run(host.remote.job("kill", label, owner), check=False, timeout=600)
                        if result.returncode in (NOT_OWNER, LABEL_DIR_UNUSABLE):
                            log(f"clean: {host}: {label}: {result.stderr.decode(errors='replace').strip()}; "
                                f"nothing of this driver's to stop")
                        elif result.returncode != 0:
                            log(f"clean: {host}: stopping the cells of {label} failed, so nothing of {label} is "
                                f"removed, on any host: {result.stderr.decode(errors='replace').strip()}")
                            unstopped.add(label)
                labels -= unstopped
            try:
                if labels or not args.label:
                    sweep(reachable, owner, labels=labels or None, idle_hours=args.idle_hours,
                          results_dir=results_dir, force=args.force, dry_run=args.dry_run, held=set(locks),
                          unreachable=len(reachable) < len(hosts))
            finally:
                for lock in locks.values():
                    lock.close()
            if unstopped:
                raise SystemExit(f"clean: the cells of {', '.join(sorted(unstopped))} could not all be stopped; "
                                 f"nothing of them was removed")
            return 0
        if args.command == "set-capacity":
            for host in load_hosts(args.hosts, args.remote_home):
                if host.capacity:
                    host.remote.install(host)
                    host.run(host.remote.job("set-capacity", host.capacity))
                    log(f"{host}: capacity {host.capacity}")
            return 0
        status(args)
        return 0
    except HostError as e:
        raise SystemExit(str(e)) from e


if __name__ == "__main__":
    sys.exit(main())
