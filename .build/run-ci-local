CONFIG_SECTION = "run-ci-local"
# the keys of the config file: the Jenkins parameters, fail_fast, and the tool's own settings
CONFIG_KEYS = {name: str for name in JENKINS_PARAMETERS}
CONFIG_KEYS.update(fail_fast=bool, hosts=str, remote_home=str, results_dir=str, maven_mirror=str, timeout_factor=int,
                   report=bool, dtest_dir=str)
# the tool's own settings, when neither the command line nor the config file sets them
SETTING_DEFAULTS = {"remote_home": DEFAULT_REMOTE_HOME, "results_dir": str(CASSANDRA_DIR / "build" / "ci-local"),
                    "maven_mirror": "", "timeout_factor": 1, "report": True, "dtest_dir": "", "fail_fast": True}


def default_config_file():
    if os.environ.get("RUN_CI_LOCAL_CONFIG"):
        return Path(os.environ["RUN_CI_LOCAL_CONFIG"])
    directory = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    return directory / "cassandra" / "run-ci-local.conf"


def load_config(path, required):
    """The [run-ci-local] settings of an INI file, typed; {} when the file is absent and not required"""
    path = Path(path).expanduser()
    if not path.exists():
        if required:
            raise SystemExit(f"config file {path} does not exist")
        return {}
    parser = configparser.ConfigParser(interpolation=None)
    try:
        parser.read(path)
    except configparser.Error as e:
        raise SystemExit(f"{path}: {e}") from e
    if set(parser.sections()) - {CONFIG_SECTION}:
        raise SystemExit(f"{path}: only a [{CONFIG_SECTION}] section is read, not {parser.sections()}")
    values = {}
    if not parser.has_section(CONFIG_SECTION):
        return values
    for key in parser[CONFIG_SECTION]:
        kind = CONFIG_KEYS.get(key)
        try:
            if kind is None:
                raise ValueError(f"unknown key; the keys are {', '.join(sorted(CONFIG_KEYS))}")
            if kind is bool:
                values[key] = parser.getboolean(CONFIG_SECTION, key)
            elif kind is int:
                values[key] = parser.getint(CONFIG_SECTION, key)
            else:
                values[key] = parser.get(CONFIG_SECTION, key)
        except ValueError as e:
            raise SystemExit(f"{path}: {key}: {e}") from e
    return values


def apply_settings(args, config):
    """The tool's own settings: the command line, else the config file, else the defaults"""
    for name in ("hosts", "remote_home", "results_dir", "maven_mirror", "timeout_factor", "report", "dtest_dir"):
        if getattr(args, name, None) is None:
            default = str(default_hosts_file()) if name == "hosts" else SETTING_DEFAULTS[name]
            setattr(args, name, config.get(name, default))


def git_upstream(src):
    """(url, branch) of the checkout's upstream, or (None, None)"""
    upstream = subprocess.run(["git", "-C", str(src), "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=False).stdout.strip()
    if "/" not in upstream:
        return None, None
    remote, branch = upstream.split("/", 1)
    url = subprocess.run(["git", "-C", str(src), "remote", "get-url", remote], stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True, check=False).stdout.strip()
    return (url, branch) if url else (None, None)


