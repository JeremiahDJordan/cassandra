def git(src, *args):
    return subprocess.run(["git", "-C", str(src), *args], stdout=subprocess.PIPE, check=True, text=True).stdout.strip()


def git_show(src, sha, path):
    return subprocess.run(["git", "-C", str(src), "show", f"{sha}:{path}"], stdout=subprocess.PIPE, check=True,
                          text=True).stdout


def junit_files(directory):
    return [p for p in Path(directory).rglob("*") if p.name.endswith((".xml", ".xml.xz")) and p.is_file()]


def open_result(path):
    return lzma.open(path, "rb") if str(path).endswith(".xz") else open(path, "rb")


def compress(directory):
    """xz the JUnit XML, which holds the output of every test, and the stage log, as Jenkins archives them"""
    files = [p for p in junit_files(directory)
             if p.name.endswith(".xml")] + [p for p in Path(directory).rglob("stage.log") if p.is_file()]
    for start in range(0, len(files), 64):
        subprocess.run(["xz", "-f"] + [str(p) for p in files[start:start + 64]], check=False)


def extract_member(tar, member, destination):
    """
    Extracts a tar member of a cell's result into destination: only files and directories, with no absolute path and
    no .., and with tarfile's data filter too where it has one
    """
    name = member.name
    if os.path.isabs(name) or ".." in Path(name).parts:
        raise tarfile.TarError(f"{name}: outside the destination")
    if not (member.isfile() or member.isdir()):
        raise tarfile.TarError(f"{name}: not a file or a directory")
    tar.extract(member, destination, **TAR_FILTER)


def file_digest(path):
    digest = hashlib.sha1()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()[:16]


def testcases(path):
    """
    (classname, name, seconds, outcome) of every testcase of a JUnit file; outcome is pass, failure, error or
    skipped
    """
    try:
        with open_result(path) as handle:
            root = ET.parse(handle).getroot()
    except (ET.ParseError, lzma.LZMAError, EOFError, OSError):
        yield ("<unreadable>", str(path), 0.0, "error")
        return
    for case in root.iter("testcase"):
        outcome = "pass"
        for child in case:
            if child.tag in ("failure", "error"):
                outcome = child.tag
                break
            if child.tag == "skipped":
                outcome = "skipped"
        try:
            seconds = float(case.get("time") or 0)
        except ValueError:
            seconds = 0.0
        yield (case.get("classname") or "", case.get("name") or "", seconds, outcome)


def cell_times(cell, duration_ms, outcome, output_dir):
    """The .tsv and .suites files recordCellTime() of the Jenkinsfile writes, for .build/ci/cell_balance.py"""
    per_class = {}
    for path in junit_files(output_dir):
        for classname, _, seconds, _ in testcases(path):
            per_class[classname] = per_class.get(classname, 0.0) + seconds
    total = sum(per_class.values())
    tsv = "\t".join(str(v) for v in (cell.step, cell.arch, cell.jdk, cell.split, cell.splits, cell.timeout_hours,
                                     duration_ms, f"{total:.3f}", outcome)) + "\n"
    longest = sorted(per_class.items(), key=lambda kv: -kv[1])[:12]
    suites = "".join(f"{seconds:.3f}\t{classname}\n" for classname, seconds in longest)
    return tsv, suites


def build_properties(src, maven_mirror=""):
    """The checkout's untracked build.properties, with maven_mirror set over it, or None"""
    properties = b""
    if (Path(src) / "build.properties").exists():
        properties = (Path(src) / "build.properties").read_bytes() + b"\n"
    if maven_mirror:
        mirror = maven_mirror.rstrip("/")
        properties += (f"artifact.remoteRepository.central={mirror}\n"
                       f"artifact.remoteRepository.apache={mirror}\n"
                       f"resolver-ant-tasks.url={mirror}/org/apache/maven/resolver/maven-resolver-ant-tasks\n").encode()
    return properties or None


def inputs_version(sha, properties):
    """What a stash is built from: the commit and the build.properties shipped with it"""
    return hashlib.sha1(sha.encode() + b"\0" + (properties or b"")).hexdigest()[:16]


def submodules(src, sha):
    """(path, name, url, commit) of the commit's submodules"""
    names, urls = {}, {}
    if subprocess.run(["git", "-C", str(src), "cat-file", "-e", f"{sha}:.gitmodules"], stderr=subprocess.DEVNULL,
                      check=False).returncode == 0:
        listing = git(src, "config", "--blob", f"{sha}:.gitmodules", "--get-regexp", r"^submodule\..*\.(path|url)$")
        for line in listing.splitlines():
            key, value = line.split(" ", 1)
            name, field = key[len("submodule."):].rsplit(".", 1)
            (names if field == "path" else urls)[name] = value
    paths = {path: name for name, path in names.items()}
    result = []
    for line in git(src, "ls-tree", "-r", "-z", sha).split("\0"):
        if not line:
            continue
        meta, path = line.split("\t", 1)
        _, kind, commit = meta.split()
        if kind == "commit":
            name = paths.get(path, path)
            result.append((path, name, urls.get(name, ""), commit))
    return result


def _add_bytes(tar, name, data):
    info = tarfile.TarInfo(name)
    info.size = len(data)
    info.mtime = int(time.time())
    tar.addfile(info, io.BytesIO(data))


def write_source_tarball(src, sha, tar_path, properties, branch=None, repository=None, remote_branch=None):
    """
    git archive of the commit with its submodules, a depth-1 .git, and the build.properties given.  The
    submodules are registered and checked out in that .git, so that the build's `git submodule update --init`
    finds nothing to do.  The .git has the commit on the given branch, by default the checkout's, and with a
    repository, as that branch, or remote_branch, of its origin remote, as a Jenkins checkout has it.
    """
    src, tar_path = Path(src), Path(tar_path)
    temporary = tar_path.with_suffix(".tmp")
    subprocess.run(["git", "-C", str(src), "archive", "--format=tar", "-o", str(temporary), sha], check=True)
    with tarfile.open(temporary, "a") as tar, tempfile.TemporaryDirectory(dir=tar_path.parent) as clone:
        # Jenkins builds a shallow clone, and the build and the summary read the sha, branch and origin from git
        branch = branch or git(src, "rev-parse", "--abbrev-ref", "HEAD")
        git(clone, "init", "-q")
        git(clone, "fetch", "-q", "--depth=1", f"file://{src}", sha)
        if branch != "HEAD":
            git(clone, "update-ref", f"refs/heads/{branch}", sha)
            git(clone, "symbolic-ref", "HEAD", f"refs/heads/{branch}")
        else:
            git(clone, "update-ref", "--no-deref", "HEAD", sha)
        if repository:
            git(clone, "remote", "add", "origin", repository)
            if (remote_branch or branch) != "HEAD":
                git(clone, "update-ref", f"refs/remotes/origin/{remote_branch or branch}", sha)
        git(clone, "read-tree", "HEAD")
        for path, name, url, commit in submodules(src, sha):
            if subprocess.run(["git", "-C", str(src / path), "cat-file", "-e", f"{commit}^{{commit}}"],
                              stderr=subprocess.DEVNULL, check=False).returncode != 0:
                raise SystemExit(f"submodule {path} at {commit} is not checked out; "
                                 f"run `git submodule update --init {path}`")
            module_archive = Path(clone) / "module.tar"
            subprocess.run(["git", "-C", str(src / path), "archive", "--format=tar", f"--prefix={path}/",
                            "-o", str(module_archive), commit], check=True)
            with tarfile.open(module_archive) as module_tar:
                for member in module_tar:
                    tar.addfile(member, module_tar.extractfile(member) if member.isfile() else None)
            module_archive.unlink()
            # the layout `git submodule update --init` leaves: .git/modules/<name>, and a .git file in the submodule
            module_git = Path(clone) / ".git" / "modules" / name
            git(clone, "init", "-q", "--bare", str(module_git))
            git(module_git, "fetch", "-q", "--depth=1", f"file://{src / path}", commit)
            git(module_git, "update-ref", "--no-deref", "HEAD", commit)
            git(module_git, "read-tree", "HEAD")
            git(module_git, "config", "core.bare", "false")
            git(module_git, "config", "core.worktree", os.path.relpath(Path(clone) / path, module_git))
            git(clone, "config", f"submodule.{name}.url", url)
            git(clone, "config", f"submodule.{name}.active", "true")
            _add_bytes(tar, f"{path}/.git", f"gitdir: {os.path.relpath(module_git, Path(clone) / path)}\n".encode())
        if properties is not None:
            _add_bytes(tar, "build.properties", properties)
        tar.add(str(Path(clone) / ".git"), arcname=".git")
    temporary.replace(tar_path)


def owner_id(results_dir):
    """Who runs a label: this machine and this results directory"""
    return hashlib.sha1(f"{socket.gethostname()}:{Path(results_dir).resolve()}".encode()).hexdigest()[:16]


def label_lock_file(out):
    """<results>/.locks/<label>.lock: outside the label's directory, which may be removed, and never removed itself"""
    return out.parent / ".locks" / f"{out.name}.lock"


def lock_label(out):
    """An exclusive lock on the label of <results>/<label>, or None when a driver on this machine holds it"""
    label_lock_file(out).parent.mkdir(parents=True, exist_ok=True)
    handle = open(label_lock_file(out), "a")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def label_active(out):
    """True while a driver on this machine runs the label"""
    if not label_lock_file(out).exists():
        return False
    handle = lock_label(out)
    if handle is None:
        return True
    handle.close()
    return False


