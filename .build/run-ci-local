def summarise(out):
    """
    A plain text summary of a label's cells and failing tests, also written to summary.txt, and the result:
    SUCCESS, UNSTABLE (failing tests) or FAILURE (a cell that failed, was lost or stopped, did not run, or left no
    test results)
    """
    state = json.loads((out / "state.json").read_text()) if (out / "state.json").exists() else {"cells": {}}
    lines = [f"run-ci-local {out.name}: {state.get('src')} at {state.get('sha')}", ""]
    failing, failed_cells, totals = [], [], {"pass": 0, "failure": 0, "error": 0, "skipped": 0}
    # the cells the last run planned, which a cell it did not get to is one of; without a plan, every cell recorded
    plan = state.get("plan") or list(state["cells"])
    if isinstance(plan, list):
        plan = {cell_id: {} for cell_id in plan}
    for cell_id, planned in sorted(plan.items()):
        entry = state["cells"].get(cell_id) or dict(planned, status="not run", rc=None)
        attempt = recorded_attempt(out, cell_id, entry)
        counts = {"pass": 0, "failure": 0, "error": 0, "skipped": 0}
        for path in junit_files(attempt / "output") if attempt else []:
            for classname, name, _, outcome in testcases(path):
                counts[outcome] += 1
                if outcome in ("failure", "error"):
                    failing.append(f"{entry.get('name')}: {classname} {name} {outcome}")
        for key, value in counts.items():
            totals[key] += value
        if not cell_succeeded(entry, entry.get("kind")):
            failed_cells.append(entry.get("name"))
        lines.append(f"{entry.get('name')}: {entry.get('status')} rc={entry.get('rc')} host={entry.get('host')} "
                     f"attempts={entry.get('attempt')} {(entry.get('duration_s') or 0) // 60}m "
                     f"tests={sum(counts.values())} failing={counts['failure'] + counts['error']}")
    result = "FAILURE" if failed_cells else "UNSTABLE" if failing else "SUCCESS"
    lines += ["", f"result: {result}",
              f"tests: passed {totals['pass']} | failed {totals['failure'] + totals['error']} | "
              f"skipped {totals['skipped']}", f"failed cells: {len(failed_cells)}"]
    lines += [f"  {name}" for name in failed_cells]
    lines += [f"failing tests: {len(failing)}"] + [f"  {f}" for f in failing]
    if report_made(out):
        lines.append(f"for a JIRA ticket: {out / 'ci_summary.html'} and {out / 'results_details.tar.xz'}")
    text = "\n".join(lines) + "\n"
    (out / "summary.txt").write_text(text)
    return text, result


